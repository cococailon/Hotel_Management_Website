@using Hotel_Management_Website.Security

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotel Management</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-ajax.css" asp-append-version="true" />

    <template id="ajax-page-styles-template">
        @await RenderSectionAsync("Styles", required: false)
    </template>
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary" data-ajax-navigation="true">
    <div id="admin-page-loading" class="admin-page-loading" aria-hidden="true"></div>

    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body hotel-floating-nav">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Mở hoặc đóng menu">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-controller="Housekeeping" asp-action="Index" class="nav-link fw-semibold">
                            Khu vực Buồng Phòng
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item d-none d-sm-block me-3">
                        <div class="text-end lh-sm">
                            <div class="fw-semibold">
                                @(User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Buồng Phòng")
                            </div>
                            <small class="text-body-secondary">
                                @(User.IsInRole(AppRoles.Housekeeping) ? "Buồng Phòng" : "Admin")
                            </small>
                        </div>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0" data-ajax="false">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>
                                <span class="d-none d-sm-inline">Đăng xuất</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark" data-enable-persistence="true">
            <div class="sidebar-brand">
                <a asp-controller="Housekeeping" asp-action="Index" class="brand-link text-decoration-none">
                    <i class="bi bi-building me-2" aria-hidden="true"></i>
                    <span class="brand-text fw-semibold">Hotel Management</span>
                </a>
            </div>

            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="true">
                        <li class="nav-item">
                            <a asp-controller="Housekeeping" asp-action="Index" class="nav-link">
                                <i class="nav-icon bi bi-house-door"></i>
                                <p>Trang chủ Buồng Phòng</p>
                            </a>
                        </li>
                        <li class="nav-header">NGHIỆP VỤ</li>
                        <li class="nav-item">
                            <a asp-controller="Housekeeping" asp-action="RoomStatus" class="nav-link">
                                <i class="nav-icon bi bi-clipboard2-check"></i>
                                <p>Quản lý tình trạng phòng</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <partial name="~/Views/Shared/UI/_FlashMessages.cshtml" />

        <main id="app-main-content" class="app-main">
            <div class="app-content">
                <div class="container-fluid py-4">
                    @RenderBody()
                </div>
            </div>
            @await RenderSectionAsync("Scripts", required: false)
        </main>

        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">Hotel Management</div>
            <strong>&copy; @DateTime.Now.Year</strong>
        </footer>

        <partial name="~/Views/Shared/UI/_ToastHost.cshtml" />
        <partial name="~/Views/Shared/UI/_ConfirmModal.cshtml" />
        <partial name="~/Views/Shared/UI/_LoadingOverlay.cshtml" />
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/lib/admin-lte/js/adminlte.min.js" asp-append-version="true"></script>
    <script src="~/js/ui-core.js" asp-append-version="true"></script>
    <script src="~/js/admin-ajax.js" asp-append-version="true"></script>
    <script src="~/js/admin-pagination.js" asp-append-version="true"></script>
</body>
</html>
