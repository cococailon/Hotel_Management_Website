@model Hotel_Management_Website.Models.ViewModels.UI.CrudToolbarViewModel

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-between gap-3">
            @if (Model.ShowCreate)
            {
                <div class="d-flex">
                    <button type="button"
                            class="btn btn-primary"
                            id="@Model.CreateButtonId">
                        <i class="bi @Model.CreateIcon me-1" aria-hidden="true"></i>
                        @Model.CreateText
                    </button>
                </div>
            }

            @if (Model.ShowSearch)
            {
                <div class="hm-search-wrap">
                    <label class="visually-hidden" for="@Model.SearchInputId">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-body">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </span>
                        <input type="search"
                               class="form-control"
                               id="@Model.SearchInputId"
                               name="@Model.SearchName"
                               value="@Model.SearchValue"
                               placeholder="@Model.SearchPlaceholder"
                               autocomplete="off" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>
