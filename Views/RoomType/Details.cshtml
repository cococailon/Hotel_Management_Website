@model Hotel_Management_Website.Models.ViewModels.RoomType.RoomTypeDetailsViewModel

@{
    var isReception = User.IsInRole("Reception");
    ViewData["Title"] = "Chi tiết loại phòng";
    Layout = User.IsInRole("Reception")
        ? "~/Views/Shared/_ReceptionLayout.cshtml"
        : "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/roomtype-details.css" asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Chi tiết loại phòng",
        Description = "Xem đầy đủ thông tin cấu hình và trạng thái của loại phòng.",
        Icon = "bi-door-open"
    })

<div class="roomtype-detail-page">

    <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center justify-content-between gap-2 mb-4">
        <a asp-controller="RoomType"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Quay lại danh sách
        </a>

        @if (!isReception)
        {
        <a asp-controller="RoomType"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>
            Sửa loại phòng
        </a>
        }
    </div>

    <section class="card border-0 shadow-sm roomtype-detail-summary mb-4">
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-lg-auto">
                    <div class="roomtype-detail-avatar" aria-hidden="true">
                        <i class="bi bi-door-open"></i>
                    </div>
                </div>

                <div class="col-12 col-lg">
                    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-2 mb-2">
                        <h1 class="h4 fw-semibold mb-0 roomtype-detail-name" title="@Model.RoomTypeName">
                            @Model.RoomTypeName
                        </h1>
                        <span class="badge @Model.StatusBadgeClass">@Model.StatusName</span>
                    </div>

                    <div class="text-body-secondary">
                        <span class="font-monospace">@Model.RoomTypeCode</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-12 col-xl-6">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-header bg-body border-bottom py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="roomtype-detail-section-icon" aria-hidden="true">
                            <i class="bi bi-door-closed"></i>
                        </div>
                        <div>
                            <h2 class="h6 mb-0 fw-semibold">Thông tin loại phòng</h2>
                            <div class="small text-body-secondary">Thông tin cấu hình cơ bản</div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <div class="roomtype-detail-label">Mã loại phòng</div>
                            <div class="roomtype-detail-value font-monospace">@Model.RoomTypeCode</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="roomtype-detail-label">Tên loại phòng</div>
                            <div class="roomtype-detail-value roomtype-detail-breakable">@Model.RoomTypeName</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="roomtype-detail-label">Tổng người lớn</div>
                            <div class="roomtype-detail-value">@Model.MaxAdults</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="roomtype-detail-label">Tổng trẻ em</div>
                            <div class="roomtype-detail-value">@Model.MaxChildren</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="roomtype-detail-label">Diện tích</div>
                            <div class="roomtype-detail-value">@Model.Area.ToString("0.##") m²</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="roomtype-detail-label">Trạng thái hoạt động</div>
                            <div class="roomtype-detail-value">
                                <span class="badge @Model.StatusBadgeClass">@Model.StatusName</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-6">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-header bg-body border-bottom py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="roomtype-detail-section-icon" aria-hidden="true">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div>
                            <h2 class="h6 mb-0 fw-semibold">Giá và cọc</h2>
                            <div class="small text-body-secondary">Thông tin chi phí của loại phòng</div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <div class="roomtype-detail-label">Giá một đêm</div>
                            <div class="roomtype-detail-value">@Model.PricePerNight.ToString("N0") ₫</div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="roomtype-detail-label">Cọc</div>
                            <div class="roomtype-detail-value">@Model.DepositPercent.ToString("0.##")%</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12">
            <section class="card border-0 shadow-sm">
                <div class="card-header bg-body border-bottom py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="roomtype-detail-section-icon" aria-hidden="true">
                            <i class="bi bi-card-text"></i>
                        </div>
                        <div>
                            <h2 class="h6 mb-0 fw-semibold">Mô tả và ghi chú</h2>
                            <div class="small text-body-secondary">Thông tin bổ sung về loại phòng</div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-12 col-xl-6">
                            <div class="roomtype-detail-label">Mô tả</div>
                            <div class="roomtype-detail-value roomtype-detail-note">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "Không có mô tả" : Model.Description)
                            </div>
                        </div>
                        <div class="col-12 col-xl-6">
                            <div class="roomtype-detail-label">Ghi chú</div>
                            <div class="roomtype-detail-value roomtype-detail-note">
                                @(string.IsNullOrWhiteSpace(Model.Note) ? "Không có ghi chú" : Model.Note)
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-12">
            <section class="card border-0 shadow-sm">
                <div class="card-header bg-body border-bottom py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="roomtype-detail-section-icon" aria-hidden="true">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div>
                            <h2 class="h6 mb-0 fw-semibold">Thông tin thời gian</h2>
                            <div class="small text-body-secondary">Thông tin audit của loại phòng</div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="roomtype-detail-label">Ngày tạo</div>
                            <div class="roomtype-detail-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="roomtype-detail-label">Ngày chỉnh sửa gần nhất</div>
                            <div class="roomtype-detail-value">@Model.LastModifiedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>
