@model Hotel_Management_Website.Models.ViewModels.Room.RoomIndexViewModel

@{
    var totalPages = Math.Max(Model.TotalPages, 1);
    var currentPage = Math.Clamp(Model.Filter.CurrentPage, 1, totalPages);

    string BuildUrl(int page, int? pageSize = null)
    {
        var size = pageSize ?? Model.Filter.PageSize;
        var parameters = new Dictionary<string, string?>
        {
            ["Filter.Search"] = Model.Filter.Search,
            ["Filter.Sort"] = ((byte)Model.Filter.Sort).ToString(),
            ["Filter.RoomTypeId"] = Model.Filter.RoomTypeId?.ToString(),
            ["Filter.Status"] = Model.Filter.Status?.ToString(),
            ["Filter.IsActive"] = Model.Filter.IsActive?.ToString().ToLowerInvariant(),
            ["Filter.CurrentPage"] = page.ToString(),
            ["Filter.PageSize"] = size.ToString()
        };

        var query = string.Join(
            "&",
            parameters
                .Where(x => !string.IsNullOrWhiteSpace(x.Value))
                .Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value!)}"));

        return string.IsNullOrWhiteSpace(query)
            ? "/Room/Index"
            : $"/Room/Index?{query}";
    }

    var pageNumbers = new List<int>();
    if (totalPages <= 7)
    {
        for (var page = 1; page <= totalPages; page++)
            pageNumbers.Add(page);
    }
    else
    {
        pageNumbers.Add(1);
        var start = Math.Max(2, currentPage - 1);
        var end = Math.Min(totalPages - 1, currentPage + 1);

        if (currentPage <= 3)
        {
            start = 2;
            end = 4;
        }
        else if (currentPage >= totalPages - 2)
        {
            start = totalPages - 3;
            end = totalPages - 1;
        }

        if (start > 2)
            pageNumbers.Add(-1);

        for (var page = start; page <= end; page++)
            pageNumbers.Add(page);

        if (end < totalPages - 1)
            pageNumbers.Add(-1);

        pageNumbers.Add(totalPages);
    }
}

<div class="room-pagination border-top p-3">
    <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center justify-content-between gap-3">
        <div class="small text-body-secondary">
            Tổng <strong>@Model.TotalRooms</strong> phòng · Trang <strong>@currentPage/@totalPages</strong> · Mỗi hàng tối đa <strong>@Model.Filter.PageSize</strong> phòng
        </div>

        <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label for="roomPageSize" class="small text-body-secondary text-nowrap mb-0">Hiển thị:</label>
                <select id="roomPageSize"
                        class="form-select form-select-sm"
                        style="width:auto;"
                        onchange="HotelPagination.changePageSize(this)">
                    @foreach (var size in new[] { 5, 10, 20, 50 })
                    {
                        <option value="@BuildUrl(1, size)" selected="@(Model.Filter.PageSize == size)">@size phòng/hàng</option>
                    }
                </select>
            </div>

            <div class="d-flex align-items-center gap-2">
                <label for="roomCurrentPage" class="small text-body-secondary text-nowrap mb-0">Trang:</label>
                <select id="roomCurrentPage"
                        class="form-select form-select-sm"
                        style="width:auto; min-width:5rem;"
                        onchange="HotelPagination.goTo(this.value)"
                        aria-label="Chọn trang sơ đồ phòng">
                    @for (var page1 = 1; page1 <= totalPages; page1++)
                    {
                        <option value="@BuildUrl(page1)" selected="@(page1 == currentPage)">Trang @page1</option>
                    }
                </select>
            </div>

            @if (totalPages > 1)
            {
                <nav aria-label="Điều hướng sơ đồ phòng">
                    <ul class="pagination pagination-sm mb-0 flex-wrap justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : null)">
                            <a class="page-link"
                               href="@BuildUrl(currentPage - 1)"
                               data-ajax-pagination="true"
                               aria-label="Trang trước">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            </a>
                        </li>

                        @foreach (var page2 in pageNumbers)
                        {
                            if (page2 == -1)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            else
                            {
                                <li class="page-item @(page2 == currentPage ? "active" : null)">
                                    <a class="page-link"
                                       href="@BuildUrl(page2)"
                                       data-ajax-pagination="true">
                                        @page2
                                    </a>
                                </li>
                            }
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : null)">
                            <a class="page-link"
                               href="@BuildUrl(currentPage + 1)"
                               data-ajax-pagination="true"
                               aria-label="Trang sau">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
