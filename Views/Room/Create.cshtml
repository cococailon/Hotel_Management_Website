@model Hotel_Management_Website.Models.ViewModels.Room.RoomCreateViewModel

@{
    ViewData["Title"] = "Tạo phòng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/room-form.css" asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Tạo phòng",
        Description = "Tạo một phòng mới và sắp xếp phòng vào tầng, hàng và thứ tự từ trái sang phải.",
        Icon = "bi-plus-square"
    })

<div class="room-form-page">
    <form id="roomCreateForm"
          asp-controller="Room"
          asp-action="Create"
          method="post"
          novalidate
          data-native-validation="true"
          data-ajax="false">

        @Html.AntiForgeryToken()

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="room-form-section-icon"><i class="bi bi-door-open" aria-hidden="true"></i></div>
                    <div>
                        <h2 class="h5 mb-1 fw-semibold">Thông tin phòng</h2>
                        <p class="text-body-secondary small mb-0">Các thông tin cơ bản và vị trí vật lý của phòng.</p>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <label asp-for="RoomCode" class="form-label required mb-0">Mã phòng</label>
                            <button type="button"
                                    id="generateRoomCodeButton"
                                    class="btn btn-outline-primary btn-sm"
                                    data-endpoint="@Url.Action("GetNextRoomCode", "Room")">
                                <i class="bi bi-magic me-1" aria-hidden="true"></i>Tự sinh mã
                            </button>
                        </div>
                        <input asp-for="RoomCode" id="roomCreateCode" class="form-control" maxlength="50" autocomplete="off" />
                        <div class="form-text">Mã chỉ được bao gồm chữ hoa, chữ thường và số; không chứa dấu cách hoặc ký tự đặc biệt và không được trùng.</div>
                        <span asp-validation-for="RoomCode" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="RoomName" class="form-label required">Tên phòng</label>
                        <input asp-for="RoomName" id="roomCreateName" class="form-control" maxlength="100" autocomplete="off" />
                        <span asp-validation-for="RoomName" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Floor" class="form-label required">Tầng</label>
                        <input asp-for="Floor" id="roomFloor" type="number" class="form-control" min="1" max="1000" />
                        <div class="room-position-suggestion" id="roomFloorSuggestion" aria-live="polite"></div>
                        <span asp-validation-for="Floor" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Row" class="form-label required">Hàng</label>
                        <input asp-for="Row" id="roomRow" type="number" class="form-control" min="1" max="1000" />
                        <div class="room-position-suggestion" id="roomRowSuggestion" aria-live="polite"></div>
                        <span asp-validation-for="Row" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="LeftToRightOrder" class="form-label required">Thứ tự</label>
                        <input asp-for="LeftToRightOrder" id="roomOrder" type="number" class="form-control" min="1" max="1000" />
                        <div class="form-text">Không được trùng vị trí Tầng + Hàng + Thứ tự.</div>
                        <span asp-validation-for="LeftToRightOrder" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="RoomTypeId" class="form-label required">Loại phòng</label>
                        <select asp-for="RoomTypeId" id="roomTypeId" class="form-select">
                            <option value="">-- Chọn loại phòng --</option>
                            @foreach (var type in Model.AvailableRoomTypes)
                            {
                                <option value="@type.Id" data-active="@type.IsActive.ToString().ToLowerInvariant()"
                                        data-selectable="@type.IsSelectable.ToString().ToLowerInvariant()">
                                    @type.Code - @type.Name
                                </option>
                            }
                        </select>
                        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="IsActive" class="form-label required">Trạng thái hoạt động</label>
                        <select asp-for="IsActive" id="roomIsActive" class="form-select">
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Dừng hoạt động</option>
                        </select>
                        <div class="form-text">Phòng đang hoạt động chỉ được chọn loại phòng đang hoạt động; phòng dừng hoạt động có thể chọn cả hai.</div>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" maxlength="255" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Note" class="form-label">Ghi chú</label>
                        <textarea asp-for="Note" class="form-control" maxlength="255" rows="3"></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mb-4">
            <a asp-controller="Room" asp-action="Index" class="btn btn-outline-secondary room-form-cancel-btn">
                Hủy
            </a>
            <button type="submit" id="roomCreateSubmitButton" class="btn btn-primary room-form-submit-btn">
                <span class="ui-button-content">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                    Tạo phòng
                </span>
                <span class="ui-button-loading d-none">
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    Đang tạo...
                </span>
            </button>
        </div>
    </form>
</div>

@section Scripts
{
    <script src="~/js/native-validation.js" asp-append-version="true"></script>
    <script src="~/js/room-form.js" asp-append-version="true"></script>
}
