<!-- ========================================================= -->
<!-- EMPLOYEE PAGE STYLE -->
<!-- ========================================================= -->

<style>

    .employee-section .card-header .btn {
        white-space: nowrap;
    }


    @@media (max-width: 575.98px) {

        .employee-section .card-header .btn {
            flex: 1 1 auto;
        }
    }


    .employee-col-action {
        width: 160px;
        min-width: 160px;
        max-width: 160px;
    }


    .employee-action-group {
        min-width: 76px;
        flex-wrap: nowrap;
        white-space: nowrap;
    }


    .employee-action-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 34px;
    }


        .employee-action-btn i {
            font-size: 1rem;
        }


    .employee-leave-btn {
        color: var(--bs-danger);
    }


        .employee-leave-btn:hover,
        .employee-leave-btn:focus-visible {
            color: var(--bs-white);
        }


    .employee-return-btn {
        color: var(--bs-success);
    }


        .employee-return-btn:hover,
        .employee-return-btn:focus-visible {
            color: var(--bs-white);
        }


    .employee-delete-btn {
        color: var(--bs-danger);
    }


        .employee-delete-btn:hover,
        .employee-delete-btn:focus-visible {
            color: var(--bs-white);
        }


    .employee-action-btn .spinner-border {
        width: 0.8rem;
        height: 0.8rem;
    }
</style>



@section Scripts
{

    <!-- ===================================================== -->
    <!-- FILTER AJAX BUTTON LOADING -->
    <!-- ===================================================== -->

    <script>

        (() => {

            "use strict";


            const forms =
                document.querySelectorAll(
                    ".employee-filter-form"
                );


            forms.forEach(
                form => {

                    if (
                        form.dataset.ajaxFilterBound ===
                        "true"
                    ) {

                        return;

                    }


                    form.dataset.ajaxFilterBound =
                        "true";


                    let submitted =
                        false;


                    form.addEventListener(
                        "submit",
                        function () {

                            if (submitted) {

                                return;

                            }


                            submitted =
                                true;


                            const submitButton =
                                form.querySelector(
                                    ".employee-filter-submit"
                                );


                            if (
                                submitButton &&
                                window.HotelUI?.setButtonLoading
                            ) {

                                window.HotelUI.setButtonLoading(

                                    submitButton,

                                    true,

                                    "Đang lọc..."

                                );

                            }

                        }
                    );

                }
            );

        })();

    </script>
    })();

</script>
    }



    <!-- ===================================================== -->
    <!-- EMPLOYEE ACTION AJAX -->
    <!-- ===================================================== -->

    <script>

        (() => {

            "use strict";


            // =================================================
            // CHỐNG BIND NHIỀU LẦN
            // =================================================

            if (
                window.__employeeAjaxActionsBound ===
                true
            ) {

                return;

            }


            window.__employeeAjaxActionsBound =
                true;



            // =================================================
            // ACTION CONFIG
            // =================================================

            const actionConfig = {

                leave: {

                    title:
                        "Xác nhận cho nghỉ việc",

                    message:
                        "Bạn có chắc muốn cho nhân viên \"{name}\" nghỉ việc?",

                    note:
                        "Hệ thống sẽ chuyển nhân viên sang trạng thái nghỉ việc và dừng hoạt động tài khoản User liên kết với nhân viên đó nếu có.",

                    confirmText:
                        "Cho nghỉ việc",

                    variant:
                        "danger"
                },


                return: {

                    title:
                        "Xác nhận trở lại làm việc",

                    message:
                        "Bạn có chắc muốn cho nhân viên \"{name}\" trở lại làm việc?",

                    note:
                        "Hệ thống sẽ chuyển nhân viên sang trạng thái đang làm việc và thực hiện tùy chọn kích hoạt lại tài khoản User liên kết với nhân viên đó nếu có.",

                    confirmText:
                        "Trở lại làm việc",

                    variant:
                        "success",

                    showActivateLinkedUser:
                        true
                },


                delete: {

                    title:
                        "Xác nhận xóa nhân viên",

                    message:
                        "Bạn có chắc muốn xóa hồ sơ của nhân viên \"{name}\"?",

                    note:
                        "",

                    confirmText:
                        "Xóa nhân viên",

                    variant:
                        "danger"
                }

            };


            // =================================================
            // FORM CONFIG
            // =================================================

            const formConfig = {

                leave: {

                    formId:
                        "employeeLeaveForm",

                    idInputId:
                        "employeeLeaveId",

                    returnUrlInputId:
                        "employeeLeaveReturnUrl"

                },


                return: {

                    formId:
                        "employeeReturnToWorkForm",

                    idInputId:
                        "employeeReturnToWorkId",

                    returnUrlInputId:
                        "employeeReturnToWorkReturnUrl"

                },


                delete: {

                    formId:
                        "employeeDeleteForm",

                    idInputId:
                        "employeeDeleteId",

                    returnUrlInputId:
                        "employeeDeleteReturnUrl"

                }

            };



            // =================================================
            // EXECUTE ACTION
            // =================================================

            async function executeAction(
                button,
                action
            ) {

                const config =
                    formConfig[action];


                if (!config) {

                    throw new Error(
                        `Không tồn tại cấu hình action: ${action}`
                    );

                }


                const form =
                    document.getElementById(
                        config.formId
                    );


                const idInput =
                    document.getElementById(
                        config.idInputId
                    );


                const returnUrlInput =
                    document.getElementById(
                        config.returnUrlInputId
                    );


                if (
                    !form ||
                    !idInput ||
                    !returnUrlInput
                ) {

                    throw new Error(
                        "Không tìm thấy hidden employee form."
                    );

                }


                const employeeId =
                    button.dataset.employeeId;


                const returnUrl =
                    button.dataset.returnUrl ||
                    (
                        window.location.pathname +
                        window.location.search
                    );


                if (!employeeId) {

                    throw new Error(
                        "Không tìm thấy Employee ID."
                    );

                }


                idInput.value =
                    employeeId;


                returnUrlInput.value =
                    returnUrl;


                const formData =
                    new FormData(
                        form
                    );


                /*
                 * Chỉ loading button hiện tại.
                 */

                if (
                    window.HotelUI?.setButtonLoading
                ) {

                    window.HotelUI.setButtonLoading(
                        button,
                        true
                    );

                }


                try {

                    if (
                        !window.HotelAjax ||
                        typeof window.HotelAjax.navigate !==
                        "function"
                    ) {

                        throw new Error(
                            "HotelAjax.navigate không tồn tại."
                        );

                    }


                    const success =
                    await window.HotelAjax.navigate(
                        form.action,
                        {
                            method: "POST",
                            body: formData,
                            historyMode: "replace",

                            // Đây là thao tác trên chính danh sách Employee
                            preserveScroll: true,

                            // Employee tự xử lý error
                            showErrorToast: false
                        }
                    );


                    if (!success) {

                        if (
                            window.HotelUI?.toast
                        ) {

                            window.HotelUI.toast(

                                "error",

                                "Có lỗi xảy ra",

                                "Không thể hoàn tất thao tác. Vui lòng thử lại."

                            );

                        }


                        return false;

                    }


                    return true;

                }
                catch (error) {

                    console.error(
                        "[Employee] Action failed:",
                        error
                    );


                    if (
                        window.HotelUI?.toast
                    ) {

                        window.HotelUI.toast(

                            "error",

                            "Có lỗi xảy ra",

                            "Không thể hoàn tất thao tác."

                        );

                    }


                    return false;

                }
                finally {

                    /*
                     * Button có thể đã bị thay khỏi DOM sau
                     * khi main content được AJAX replace.
                     *
                     * setButtonLoading vẫn an toàn trên
                     * element cũ.
                     */

                    if (
                        window.HotelUI?.setButtonLoading
                    ) {

                        window.HotelUI.setButtonLoading(

                            button,

                            false

                        );

                    }

                }

            }



            // =================================================
            // SHOW CONFIRMATION
            // =================================================

            function showConfirmation(
                button,
                action
            ) {

                const config =
                    actionConfig[action];


                if (!config) {

                    console.error(
                        `[Employee] Không tồn tại action: ${action}`
                    );

                    return;

                }


                const employeeName =
                    button.dataset.employeeName ||
                    "nhân viên";


                const message =
                    config.message.replace(
                        "{name}",
                        employeeName
                    );


                if (
                    !window.HotelUI ||
                    typeof window.HotelUI.showConfirm !==
                    "function"
                ) {

                    console.error(
                        "[Employee] HotelUI.showConfirm không tồn tại."
                    );

                    return;

                }


                window.HotelUI.showConfirm({

                    title:
                        config.title,

                    message:
                        message,

                    note:
                        config.note,

                    confirmText:
                        config.confirmText,

                    variant:
                        config.variant,

                    showActivateLinkedUser:
                        config.showActivateLinkedUser === true,

                    onConfirm:
                        async function () {

                            if (action === "return") {

                                const activateCheckbox =
                                    document.getElementById(
                                        "uiConfirmActivateLinkedUser"
                                    );

                                const activateInput =
                                    document.getElementById(
                                        "employeeReturnToWorkActivateLinkedUser"
                                    );

                                if (activateInput) {
                                    activateInput.value =
                                        activateCheckbox?.checked === true
                                            ? "true"
                                            : "false";
                                }
                            }

                            await executeAction(

                                button,

                                action

                            );

                        }

                });

            }



            // =================================================
            // FIND ACTION
            // =================================================

            function getActionFromButton(
                button
            ) {

                if (
                    button.classList.contains(
                        "employee-leave-btn"
                    )
                ) {

                    return "leave";

                }


                if (
                    button.classList.contains(
                        "employee-return-btn"
                    )
                ) {

                    return "return";

                }


                if (
                    button.classList.contains(
                        "employee-delete-btn"
                    )
                ) {

                    return "delete";

                }


                return null;

            }



            // =================================================
            // EVENT DELEGATION
            // =================================================

            document.addEventListener(

                "click",

                function (event) {

                    const target =
                        event.target instanceof Element
                            ? event.target
                            : null;


                    if (!target) {

                        return;

                    }


                    const button =
                        target.closest(

                            ".employee-leave-btn, " +
                            ".employee-return-btn, " +
                            ".employee-delete-btn"

                        );


                    if (!button) {

                        return;

                    }


                    const action =
                        getActionFromButton(
                            button
                        );


                    if (!action) {

                        return;

                    }


                    /*
                     * Các nút này không được submit
                     * filter form.
                     */

                    event.preventDefault();

                    event.stopPropagation();


                    /*
                     * Nếu button đã disable/loading thì bỏ qua.
                     */

                    if (
                        button.disabled
                    ) {

                        return;

                    }


                    showConfirmation(

                        button,

                        action

                    );

                },

                true

            );

        })();

    </script>
}