@model Hotel_Management_Website.Models.ViewModels.Employee.EmployeeIndexViewModel

@{
    ViewData["Title"] = "Quản lý nhân viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/employee-index.css" />
}

@await Html.PartialAsync(
"~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Quản lý nhân viên",
        Description = "Xem danh sách nhân viên theo bộ phận, tìm kiếm, sắp xếp và lọc.",
        Icon = "bi-people"
    })

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    @await Html.PartialAsync(
    "~/Views/Shared/UI/_ErrorState.cshtml",
        new Hotel_Management_Website.Models.ViewModels.UI.StateViewModel
        {
            Message = Model.LoadError,
            Icon = "bi-exclamation-triangle"
        })
}
else
{
    <!-- ===================================================== -->
    <!-- RECEPTION -->
    <!-- ===================================================== -->

    <form id="receptionFilterForm"
          class="employee-filter-form"
          method="get"
          asp-controller="Employee"
          asp-action="Index">

        <section class="employee-section card border-0 shadow-sm mb-4">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <div class="card-header bg-body border-bottom py-3">

                <div class="d-flex flex-column flex-md-row
                                align-items-md-center
                                justify-content-between
                                gap-2">

                    <div class="d-flex align-items-center gap-3 min-width-0">

                        <div class="employee-section-icon"
                             aria-hidden="true">

                            <i class="bi bi-person-vcard"></i>

                        </div>

                        <div class="min-width-0">

                            <h2 class="h5 mb-1 fw-semibold">
                                Lễ Tân
                            </h2>

                            <p class="text-body-secondary small mb-0">
                                @Model.Reception.Description
                            </p>

                        </div>

                    </div>


                    <div class="d-flex flex-wrap
                                    align-items-center
                                    gap-2">

                        <a asp-controller="Employee"
                           asp-action="Create"
                           asp-route-position="0"
                           class="btn btn-primary btn-sm">

                            <i class="bi bi-person-plus me-1"
                               aria-hidden="true"></i>

                            Thêm nhân viên

                        </a>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- FILTER -->
            <!-- ================================================= -->

            <div class="card-body border-bottom employee-filter-panel">

                <div class="row g-2 g-lg-3 align-items-end">

                    <!-- SEARCH -->

                    <div class="col-12 col-xl-4">

                        <label for="receptionSearch"
                               class="form-label small fw-semibold">

                            Tìm kiếm

                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-body">

                                <i class="bi bi-search"
                                   aria-hidden="true"></i>

                            </span>

                            <input id="receptionSearch"
                                   type="search"
                                   class="form-control"
                                   name="Reception.Search"
                                   value="@Model.Reception.Filter.Search"
                                   placeholder="Tên hoặc mã nhân viên"
                                   autocomplete="off" />

                        </div>

                    </div>


                    <!-- SORT -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label for="receptionSort"
                               class="form-label small fw-semibold">

                            Sắp xếp

                        </label>

                        <select id="receptionSort"
                                name="Reception.Sort"
                                class="form-select">

                            @await Html.PartialAsync(
                            "~/Views/Employee/_SortOptions.cshtml",
                                                Model.Reception.Filter.Sort)

                    </select>

                </div>


                <!-- SEX -->

                <div class="col-12 col-md-3 col-xl-2">

                    <label for="receptionSex"
                           class="form-label small fw-semibold">

                        Giới tính

                    </label>

                    <select id="receptionSex"
                            name="Reception.Sex"
                            class="form-select">

                        <option value=""
                                selected="@(Model.Reception.Filter.Sex is null ? "selected" : null)">
                            Tất cả
                        </option>

                        <option value="0"
                                selected="@(Model.Reception.Filter.Sex == 0 ? "selected" : null)">
                            Nam
                        </option>

                        <option value="1"
                                selected="@(Model.Reception.Filter.Sex == 1 ? "selected" : null)">
                            Nữ
                        </option>

                        <option value="2"
                                selected="@(Model.Reception.Filter.Sex == 2 ? "selected" : null)">
                            Khác
                        </option>

                    </select>

                </div>


                <!-- STATUS -->

                <div class="col-12 col-md-3 col-xl-2">

                    <label for="receptionStatus"
                           class="form-label small fw-semibold">

                        Trạng thái

                    </label>

                    <select id="receptionStatus"
                            name="Reception.Status"
                            class="form-select">

                        <option value=""
                                selected="@(Model.Reception.Filter.Status is null ? "selected" : null)">
                            Tất cả
                        </option>

                        <option value="0"
                                selected="@(Model.Reception.Filter.Status == 0 ? "selected" : null)">
                            Đã nghỉ
                        </option>

                        <option value="1"
                                selected="@(Model.Reception.Filter.Status == 1 ? "selected" : null)">
                            Đang làm
                        </option>

                    </select>

                </div>


                <!-- ACTION -->

                <div class="col-12 col-xl-1">

                    <div class="d-flex gap-2 justify-content-xl-end">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1 flex-xl-grow-0 employee-filter-submit"
                                title="Áp dụng bộ lọc Lễ Tân">

                            <span class="ui-button-content">

                                <i class="bi bi-funnel me-1"
                                   aria-hidden="true"></i>

                                <span class="d-xl-none d-xxl-inline">
                                    Lọc
                                </span>

                            </span>

                            <span class="ui-button-loading d-none">

                                <span class="spinner-border spinner-border-sm"
                                      role="status"
                                      aria-hidden="true"></span>

                                Đang lọc...

                            </span>

                        </button>


                        <button type="submit"
                                name="ResetSection"
                                value="reception"
                                class="btn btn-outline-secondary"
                                title="Đặt lại bộ lọc Lễ Tân"
                                aria-label="Đặt lại bộ lọc Lễ Tân">

                            <i class="bi bi-arrow-counterclockwise"
                               aria-hidden="true"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- PRESERVE HOUSEKEEPING FILTER -->
        <!-- ================================================= -->

        <input type="hidden"
               name="Housekeeping.Search"
               value="@Model.Housekeeping.Filter.Search" />

        <input type="hidden"
               name="Housekeeping.Sort"
               value="@((byte)Model.Housekeeping.Filter.Sort)" />


        @if (Model.Housekeeping.Filter.Sex.HasValue)
            {
                <input type="hidden"
                       name="Housekeeping.Sex"
                       value="@Model.Housekeeping.Filter.Sex.Value" />
            }


            @if (Model.Housekeeping.Filter.Status.HasValue)
            {
                <input type="hidden"
                       name="Housekeeping.Status"
                       value="@Model.Housekeeping.Filter.Status.Value" />
            }


            <input type="hidden"
                   name="Housekeeping.CurrentPage"
                   value="@Model.Housekeeping.Filter.CurrentPage" />

            <input type="hidden"
                   name="Housekeeping.PageSize"
                   value="@Model.Housekeeping.Filter.PageSize" />


            <!-- ================================================= -->
            <!-- RECEPTION TABLE -->
            <!-- ================================================= -->
            @await Html.PartialAsync(
            "~/Views/Employee/_EmployeeTable.cshtml",
                Model.Reception)

    </section>

</form>



