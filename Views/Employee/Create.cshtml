@model Hotel_Management_Website.Models.ViewModels.Employee.EmployeeCreateViewModel

@{
    ViewData["Title"] = "Thêm nhân viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var today = DateOnly.FromDateTime(DateTime.Today);
    var selectedPosition = Model.Position == 1
        ? "Buồng Phòng"
        : "Lễ Tân";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/employee-create.css" />
}

@await Html.PartialAsync(
    "~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Thêm nhân viên",
        Description = "Tạo hồ sơ nhân viên mới cho khách sạn.",
        Icon = "bi-person-plus"
    })

<div class="employee-create-page">

    <form id="employeeCreateForm"
          asp-controller="Employee"
          asp-action="Create"
          method="post"
          novalidate>

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <!-- ===================================================== -->
        <!-- BASIC INFORMATION -->
        <!-- ===================================================== -->

        <section class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-body border-bottom">

                <div class="d-flex align-items-center gap-3">

                    <div class="employee-create-section-icon">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h2 class="h5 mb-1 fw-semibold">
                            Thông tin cơ bản
                        </h2>

                        <p class="text-body-secondary small mb-0">
                            Thông tin định danh và cá nhân của nhân viên.
                        </p>
                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <!-- EmployeeCode -->
                    <div class="col-12 col-lg-6">

                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <label asp-for="EmployeeCode"
                                   class="form-label required mb-0">
                                Mã nhân viên
                            </label>

                            <button type="button"
                                    class="btn btn-outline-primary btn-sm employee-generate-code-button"
                                    id="employeeGenerateCodeButton">
                                <i class="bi bi-magic me-1" aria-hidden="true"></i>
                                Tự sinh mã
                            </button>
                        </div>

                        <input asp-for="EmployeeCode"
                               class="form-control"
                               autocomplete="off"
                               maxlength="50"
                               placeholder="Ví dụ: NV1" />

                        <div class="form-text">
                            Mã bắt buộc nhập, chỉ gồm chữ cái và chữ số, không chứa dấu cách/ký tự đặc biệt và không được trùng. Nút <strong>Tự sinh mã</strong> tạo mã theo dạng NV1, NV2, NV100...
                        </div>

                        <span asp-validation-for="EmployeeCode"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- EmployeeName -->
                    <div class="col-12 col-lg-6">

                        <label asp-for="EmployeeName"
                               class="form-label required">
                            Tên nhân viên
                        </label>

                        <input asp-for="EmployeeName"
                               class="form-control"
                               autocomplete="off"
                               maxlength="100"
                               placeholder="Nhập họ và tên nhân viên" />

                        <span asp-validation-for="EmployeeName"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- DateOfBirth -->
                    <div class="col-12 col-md-6 col-lg-4">

                        <label asp-for="DateOfBirth"
                               class="form-label required">
                            Ngày sinh
                        </label>

                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control"
                               max='@today.ToString("yyyy-MM-dd")' />

                        @{
                            var dateOfBirthServerError = string.Join(
                                " ",
                                ViewData.ModelState[nameof(Model.DateOfBirth)]?.Errors
                                    .Select(e => e.ErrorMessage)
                                    .Where(e => !string.IsNullOrWhiteSpace(e))
                                    ?? Enumerable.Empty<string>());
                        }
                        <span id="DateOfBirthBusinessValidationMessage"
                              class="text-danger employee-date-validation-message">
                            @dateOfBirthServerError
                        </span>

                    </div>

                    <!-- Sex -->
                    <div class="col-12 col-md-6 col-lg-4">

                        <label asp-for="Sex"
                               class="form-label required">
                            Giới tính
                        </label>

                        <select asp-for="Sex"
                                class="form-select">

                            <option value="">
                                -- Chọn giới tính --
                            </option>

                            <option value="0">Nam</option>
                            <option value="1">Nữ</option>
                            <option value="2">Khác</option>

                        </select>

                        <span asp-validation-for="Sex"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- ===================================================== -->
        <!-- WORK INFORMATION -->
        <!-- ===================================================== -->

        <section class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-body border-bottom">

                <div class="d-flex align-items-center gap-3">

                    <div class="employee-create-section-icon">
                        <i class="bi bi-briefcase" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h2 class="h5 mb-1 fw-semibold">
                            Thông tin công việc
                        </h2>

                        <p class="text-body-secondary small mb-0">
                            Bộ phận, ngày làm việc và trạng thái hiện tại.
                        </p>
                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <!-- Position -->
                    <div class="col-12 col-md-6 col-lg-4">

                        <label asp-for="Position"
                               class="form-label required">
                            Bộ phận / Chức vụ
                        </label>

                        <select asp-for="Position"
                                class="form-select">

                            <option value="0">Lễ Tân</option>
                            <option value="1">Buồng Phòng</option>

                        </select>

                        <span asp-validation-for="Position"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- StartDate -->
                    <div class="col-12 col-md-6 col-lg-4">

                        <label asp-for="StartDate"
                               class="form-label required">
                            Ngày vào làm
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                        @{
                            var startDateServerError = string.Join(
                                " ",
                                ViewData.ModelState[nameof(Model.StartDate)]?.Errors
                                    .Select(e => e.ErrorMessage)
                                    .Where(e => !string.IsNullOrWhiteSpace(e))
                                    ?? Enumerable.Empty<string>());
                        }
                        <span id="StartDateBusinessValidationMessage"
                              class="text-danger employee-date-validation-message">
                            @startDateServerError
                        </span>

                    </div>

                    <!-- Status -->
                    <div class="col-12 col-md-6 col-lg-4">

                        <label asp-for="Status"
                               class="form-label required">
                            Trạng thái
                        </label>

                        <select asp-for="Status"
                                class="form-select"
                                id="employeeStatus">

                            <option value="1">Đang làm</option>
                            <option value="0">Đã nghỉ</option>

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- EndDate -->
                    <div class="col-12 col-md-6 col-lg-4">

                        <label asp-for="EndDate"
                               class="form-label">
                            Ngày nghỉ việc
                        </label>

                        <input asp-for="EndDate"
                               type="date"
                               class="form-control"
                               id="employeeEndDate" />

                        <div class="form-text">
                            Bắt buộc nếu trạng thái là Đã nghỉ.
                        </div>

                        @{
                            var endDateServerError = string.Join(
                                " ",
                                ViewData.ModelState[nameof(Model.EndDate)]?.Errors
                                    .Select(e => e.ErrorMessage)
                                    .Where(e => !string.IsNullOrWhiteSpace(e))
                                    ?? Enumerable.Empty<string>());
                        }
                        <span id="EndDateBusinessValidationMessage"
                              class="text-danger employee-date-validation-message">
                            @endDateServerError
                        </span>

                    </div>

                </div>

            </div>

        </section>


        <!-- ===================================================== -->
        <!-- NOTE -->
        <!-- ===================================================== -->

        <section class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-body border-bottom">

                <div class="d-flex align-items-center gap-3">

                    <div class="employee-create-section-icon">
                        <i class="bi bi-sticky" aria-hidden="true"></i>
                    </div>

                    <div>
                        <h2 class="h5 mb-1 fw-semibold">
                            Ghi chú
                        </h2>

                        <p class="text-body-secondary small mb-0">
                            Thông tin bổ sung về nhân viên nếu cần.
                        </p>
                    </div>

                </div>

            </div>

            <div class="card-body">

                <label asp-for="Note"
                       class="form-label">
                    Ghi chú
                </label>

                <textarea asp-for="Note"
                          class="form-control"
                          rows="4"
                          maxlength="255"
                          placeholder="Nhập ghi chú nếu có..."></textarea>

                <div class="d-flex justify-content-between gap-2 mt-1">
                    <span asp-validation-for="Note"
                          class="text-danger">
                    </span>

                    <span class="form-text ms-auto">
                        Tối đa 255 ký tự.
                    </span>
                </div>

            </div>

        </section>


        <!-- ===================================================== -->
        <!-- ACTIONS -->
        <!-- ===================================================== -->

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 mb-4">

            <a asp-controller="Employee"
               asp-action="Index"
               class="btn btn-outline-secondary employee-create-cancel-btn">

                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                Quay lại danh sách

            </a>

            <button type="submit"
                    class="btn btn-primary"
                    id="employeeCreateSubmitButton">

                <span class="ui-button-content">
                    <i class="bi bi-person-plus me-1" aria-hidden="true"></i>
                    Tạo nhân viên
                </span>

                <span class="ui-button-loading d-none">
                    <span class="spinner-border spinner-border-sm me-1"
                          role="status"
                          aria-hidden="true"></span>
                    Đang tạo...
                </span>

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            "use strict";

            const form = document.getElementById("employeeCreateForm");
            const submitButton = document.getElementById("employeeCreateSubmitButton");
            const statusSelect = document.getElementById("employeeStatus");
            const endDateInput = document.getElementById("employeeEndDate");
            const confirmModal = document.getElementById("uiConfirmModal");
            const generateCodeButton = document.getElementById("employeeGenerateCodeButton");
            const employeeCodeInput = document.getElementById("EmployeeCode");

            if (!form || !submitButton || !statusSelect || !endDateInput || !confirmModal || !employeeCodeInput || !generateCodeButton) {
                return;
            }

            let confirmedSubmit = false;
            let isSubmitting = false;

            const getLocalToday = () => {
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, "0");
                const day = String(now.getDate()).padStart(2, "0");
                return `${year}-${month}-${day}`;
            };

            const generateEmployeeCode = async () => {
                generateCodeButton.disabled = true;
                const originalHtml = generateCodeButton.innerHTML;
                generateCodeButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Đang sinh...';
                try {
                    const response = await fetch('@Url.Action("GenerateCode", "Employee")', {
                        method: "GET",
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    const data = await response.json();
                    if (!response.ok || !data.success || !data.code) {
                        throw new Error(data.message || "Không thể tự sinh mã nhân viên.");
                    }

                    employeeCodeInput.value = data.code;
                    setFieldError("EmployeeCode", "");
                    employeeCodeInput.focus();
                } catch (error) {
                    window.HotelUI?.toast?.(
                        "error",
                        "Không thể tự sinh mã",
                        error?.message || "Không thể tự sinh mã nhân viên. Vui lòng thử lại."
                    );
                } finally {
                    generateCodeButton.disabled = false;
                    generateCodeButton.innerHTML = originalHtml;
                }
            };

            generateCodeButton.addEventListener("click", generateEmployeeCode);

            const syncEndDateState = () => {
                const isWorking = statusSelect.value === "1";

                // Chỉ thay đổi trạng thái nhập (disabled), tuyệt đối không tự xóa
                // giá trị Ngày nghỉ việc của người dùng.
                endDateInput.disabled = isWorking;

            };

            const dateValidationMessageIds = {
                DateOfBirth: "DateOfBirthBusinessValidationMessage",
                StartDate: "StartDateBusinessValidationMessage",
                EndDate: "EndDateBusinessValidationMessage"
            };

            const setFieldError = (fieldName, message) => {
                const input = document.getElementById(fieldName);
                const messageElement = dateValidationMessageIds[fieldName]
                    ? document.getElementById(dateValidationMessageIds[fieldName])
                    : document.querySelector(`[data-valmsg-for="${fieldName}"]`);

                if (messageElement) {
                    messageElement.textContent = message || "";
                }

                if (input) {
                    input.classList.toggle("input-validation-error", Boolean(message));
                    input.classList.toggle("is-invalid", Boolean(message));
                }
            };

            const clearBusinessErrors = () => {
                ["DateOfBirth", "StartDate", "EndDate"].forEach(fieldName => {
                    setFieldError(fieldName, "");
                });
            };

            const validateBusinessRules = () => {
                clearBusinessErrors();

                const dobInput = document.getElementById("DateOfBirth");
                const startInput = document.getElementById("StartDate");

                const dob = dobInput?.value || "";
                const start = startInput?.value || "";
                const end = endDateInput.value || "";
                const today = getLocalToday();
                const status = statusSelect.value;

                let isValid = true;
                let firstInvalidInput = null;

                const addError = (fieldName, input, message) => {
                    setFieldError(fieldName, message);
                    isValid = false;

                    if (!firstInvalidInput && input) {
                        firstInvalidInput = input;
                    }
                };

                if (dob && dob >= today) {
                    addError(
                        "DateOfBirth",
                        dobInput,
                        "Ngày sinh phải bé hơn ngày hiện tại."
                    );
                }

                if (dob && start && dob >= start) {
                    addError(
                        "StartDate",
                        startInput,
                        "Ngày vào làm phải sau ngày sinh."
                    );
                }

                if (status === "0" && !end) {
                    addError(
                        "EndDate",
                        endDateInput,
                        "Nhân viên đã nghỉ việc phải có ngày nghỉ việc."
                    );
                }

                if (status === "1" && end) {
                    addError(
                        "EndDate",
                        endDateInput,
                        "Nhân viên đang làm không được có ngày nghỉ việc."
                    );
                }

                if (start && end && end < start) {
                    addError(
                        "EndDate",
                        endDateInput,
                        "Ngày nghỉ việc không được trước ngày vào làm."
                    );
                }

                if (firstInvalidInput) {
                    firstInvalidInput.focus();
                }

                return isValid;
            };

            statusSelect.addEventListener("change", () => {
                syncEndDateState();
                setFieldError("EndDate", "");
            });

            const validateDateFieldsOnChange = (changedField) => {
                const dobInput = document.getElementById("DateOfBirth");
                const startInput = document.getElementById("StartDate");
                const dob = dobInput?.value || "";
                const start = startInput?.value || "";
                const end = endDateInput.value || "";
                const today = getLocalToday();

                // Validation theo đúng trường vừa thay đổi và các trường có
                // quan hệ trực tiếp với trường đó. Không xóa/đổi value input.
                if (changedField === "DateOfBirth") {
                    setFieldError("DateOfBirth", "");
                    setFieldError("StartDate", "");

                    if (dob && dob >= today) {
                        setFieldError(
                            "DateOfBirth",
                            "Ngày sinh phải bé hơn ngày hiện tại."
                        );
                    }

                    if (dob && start && dob >= start) {
                        setFieldError(
                            "StartDate",
                            "Ngày vào làm phải sau ngày sinh."
                        );
                    }

                    return;
                }

                if (changedField === "StartDate") {
                    setFieldError("StartDate", "");

                    if (dob && start && dob >= start) {
                        setFieldError(
                            "StartDate",
                            "Ngày vào làm phải sau ngày sinh."
                        );
                    }

                    // Khi người dùng vừa thay đổi Ngày vào làm, lỗi quan hệ
                    // với Ngày nghỉ việc được hiển thị ngay tại Ngày vào làm.
                    if (start && end && end < start) {
                        setFieldError(
                            "StartDate",
                            "Ngày vào làm không được sau ngày nghỉ việc."
                        );
                    }

                    return;
                }

                if (changedField === "EndDate") {
                    setFieldError("EndDate", "");

                    if (start && end && end < start) {
                        setFieldError(
                            "EndDate",
                            "Ngày nghỉ việc không được trước ngày vào làm."
                        );
                    }
                }
            };

            const dateOfBirthInput = document.getElementById("DateOfBirth");
            const startDateInput = document.getElementById("StartDate");

            dateOfBirthInput?.addEventListener("change", () => {
                validateDateFieldsOnChange("DateOfBirth");
            });

            startDateInput?.addEventListener("change", () => {
                validateDateFieldsOnChange("StartDate");
            });

            // jQuery Validate có thể xử lý focusout/blur sau khi validation
            // nghiệp vụ đã ghi lỗi tùy chỉnh vào asp-validation-for và xóa
            // thông báo khi giá trị HTML cơ bản vẫn được xem là hợp lệ.
            // Re-validate ở cuối vòng event để giữ nguyên lỗi nghiệp vụ mà
            // không thay đổi giá trị người dùng đã nhập.
            dateOfBirthInput?.addEventListener("blur", () => {
                window.setTimeout(() => {
                    validateDateFieldsOnChange("DateOfBirth");
                }, 0);
            });

            startDateInput?.addEventListener("blur", () => {
                window.setTimeout(() => {
                    validateDateFieldsOnChange("StartDate");
                }, 0);
            });

            endDateInput.addEventListener("blur", () => {
                window.setTimeout(() => {
                    validateDateFieldsOnChange("EndDate");
                }, 0);
            });

            employeeCodeInput.addEventListener("input", () => {
                if (/^[A-Za-z0-9]*$/.test(employeeCodeInput.value)) {
                    setFieldError("EmployeeCode", "");
                }
            });

            endDateInput.addEventListener("change", () => {
                validateDateFieldsOnChange("EndDate");
            });

            syncEndDateState();

            form.addEventListener("submit", function (event) {
                if (confirmedSubmit) {
                    return;
                }

                event.preventDefault();

                if (isSubmitting) {
                    return;
                }

                // Business validation phải chạy trước jQuery validation để
                // lỗi nghiệp vụ được ghi trực tiếp vào đúng asp-validation-for.
                if (!validateBusinessRules()) {
                    return;
                }

                // Sau khi business validation hợp lệ mới chạy DataAnnotation/jQuery.
                if (
                    window.jQuery &&
                    typeof window.jQuery.fn.validate === "function" &&
                    !window.jQuery(form).valid()
                ) {
                    return;
                }

                const employeeCode = employeeCodeInput.value.trim();
                if (!employeeCode) {
                    setFieldError("EmployeeCode", "Vui lòng nhập mã nhân viên.");
                    employeeCodeInput.focus();
                    return;
                }

                if (!/^[A-Za-z0-9]+$/.test(employeeCode)) {
                    setFieldError("EmployeeCode", "Mã nhân viên chỉ được chứa chữ cái và chữ số, không chứa dấu cách hoặc ký tự đặc biệt.");
                    employeeCodeInput.focus();
                    return;
                }

                const employeeName =
                    document.getElementById("EmployeeName")?.value?.trim()
                    || "nhân viên này";

                window.HotelUI?.showConfirm({
                    title: "Xác nhận tạo nhân viên",
                    message: `Bạn có chắc muốn tạo nhân viên "${employeeName}" không?`,
                    note: "",
                    confirmText: "Tạo nhân viên",
                    icon: "bi-person-plus",
                    variant: "primary",
                    onConfirm: function () {
                        isSubmitting = true;
                        confirmedSubmit = true;

                        window.HotelUI?.setButtonLoading(
                            submitButton,
                            true,
                            "Đang tạo..."
                        );

                        if (typeof form.requestSubmit === "function") {
                            form.requestSubmit(submitButton);
                        } else {
                            HTMLFormElement.prototype.submit.call(form);
                        }
                    }
                });
            });

            window.addEventListener("pageshow", function () {
                confirmedSubmit = false;
                isSubmitting = false;

                window.HotelUI?.setButtonLoading(
                    submitButton,
                    false
                );

                syncEndDateState();
            });
        })();
    </script>
}
