@model Hotel_Management_Website.Models.ViewModels.Booking.BookingCreateViewModel

@{
    ViewData["Title"] = "Tạo lịch đặt phòng";
    Layout = User.IsInRole("Reception")
        ? "~/Views/Shared/_ReceptionLayout.cshtml"
        : "~/Views/Shared/_AdminLayout.cshtml";

    var isStep1 = Model.Step == 1;
    var isStep2 = Model.Step == 2;
}

@section Styles
{
    <link rel="stylesheet" href="~/css/booking-create.css" asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Tạo lịch đặt phòng",
        Description = isStep1
            ? "Bước 1: chọn phòng, số lượng người và thời gian, sau đó kiểm tra khả năng đặt phòng."
            : "Bước 2: nhập thông tin đặt phòng, khách hàng, tiền cọc và xác nhận tạo.",
        Icon = "bi-calendar-plus"
    })

<div class="booking-create-page">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 mb-4">
        <a asp-controller="Booking"
           asp-action="CancelCreate"
           asp-route-draftId="@Model.DraftId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Quay lại danh sách
        </a>

        <div class="booking-create-stepper" aria-label="Các bước tạo lịch đặt phòng">
            <div class="booking-step @(isStep1 ? "is-active" : "is-done")">
                <span class="booking-step-number">1</span>
                <span>Chọn phòng &amp; kiểm tra</span>
            </div>
            <div class="booking-step-line"></div>
            <div class="booking-step @(isStep2 ? "is-active" : "")">
                <span class="booking-step-number">2</span>
                <span>Thông tin &amp; xác nhận</span>
            </div>
        </div>
    </div>

    @{
        // Chỉ gom lỗi cấp form (key rỗng) vào khu vực thông báo chung.
        // Lỗi của từng field phải hiển thị ngay dưới field tương ứng.
        var topErrors = ViewData.ModelState
            .Where(x => string.IsNullOrWhiteSpace(x.Key))
            .SelectMany(x => x.Value?.Errors
                .Select(error => error.ErrorMessage)
                ?? Enumerable.Empty<string>())
            .Select(message => message?.Trim())
            .Where(message => !string.IsNullOrWhiteSpace(message))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var hasTopErrors = topErrors.Count > 0;
        var hasFailedAvailabilityMessage =
            !Model.AvailabilitySucceeded &&
            !string.IsNullOrWhiteSpace(Model.AvailabilityMessage);
    }

    @if (isStep1 && (hasTopErrors || hasFailedAvailabilityMessage))
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
            <div class="fw-semibold mb-1">
                <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                Vui lòng kiểm tra lại thông tin.
            </div>

            <ul class="mb-0 ps-4">
                @foreach (var error in topErrors)
                {
                    <li>@error</li>
                }

                @if (hasFailedAvailabilityMessage &&
                     !topErrors.Contains(Model.AvailabilityMessage!.Trim(), StringComparer.OrdinalIgnoreCase))
                {
                    <li>@Model.AvailabilityMessage</li>
                }
            </ul>
        </div>
    }
    else if (Model.AvailabilitySucceeded &&
             !string.IsNullOrWhiteSpace(Model.AvailabilityMessage))
    {
        <div class="alert alert-success shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
            @Model.AvailabilityMessage
        </div>
    }

    @if (isStep1)
    {
    <form asp-controller="Booking"
          asp-action="PrepareCreate"
          method="post"
          id="bookingStepOneForm"
          data-booking-create-form="step-one"
          data-ajax="false"
          data-server-today="@DateTime.Today.ToString("yyyy-MM-dd")">
        @Html.AntiForgeryToken()

        @if (!string.IsNullOrWhiteSpace(Model.DraftId))
        {
            <input type="hidden" asp-for="DraftId" />
        }

        <button type="submit"
                id="refreshCreateRoomTypesButton"
                class="d-none"
                formnovalidate
                formaction="@Url.Action("RefreshCreate", "Booking")"
                aria-hidden="true">
            Làm mới danh sách phòng
        </button>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="booking-create-section-icon">
                        <i class="bi bi-calendar-range" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h2 class="h6 mb-0 fw-semibold">Thời gian lưu trú</h2>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="CheckInDate" class="form-label fw-semibold">
                            Ngày check in dự kiến
                        </label>
                        <input asp-for="CheckInDate"
                               id="step1CheckInDate"
                               type="date"
                               class="form-control" />
                        <div class="form-text">
                            Giờ mặc định:
                            <strong>@Model.DefaultCheckInTime.ToString("HH\\:mm")</strong>
                        </div>
                        <span asp-validation-for="CheckInDate" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="CheckOutDate" class="form-label fw-semibold">
                            Ngày check out dự kiến
                        </label>
                        <input asp-for="CheckOutDate"
                               id="step1CheckOutDate"
                               type="date"
                               class="form-control" />
                        <div class="form-text">
                            Giờ mặc định:
                            <strong>@Model.DefaultCheckOutTime.ToString("HH\\:mm")</strong>
                        </div>
                        <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <div class="booking-create-section-icon">
                            <i class="bi bi-door-open" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h2 class="h6 mb-0 fw-semibold">Loại phòng cần thuê</h2>
                            <div class="small text-body-secondary">
                                Chọn từng loại phòng và số phòng cần thuê. Tổng số người nhập bên dưới chỉ dùng để kiểm tra sức chứa; chưa phân vào từng phòng.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="TotalAdults" class="form-label fw-semibold">
                            Tổng người lớn
                        </label>
                        <input asp-for="TotalAdults"
                               class="form-control"
                               type="number"
                               min="0"
                               max="9999"
                               id="step1TotalAdultsInput" />
                        <div class="form-text">
                            Tổng người lớn phải lớn hơn 0.
                        </div>
                        <span asp-validation-for="TotalAdults" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="TotalChildren" class="form-label fw-semibold">
                            Tổng trẻ em
                        </label>
                        <input asp-for="TotalChildren"
                               class="form-control"
                               type="number"
                               min="0"
                               max="9999"
                               id="step1TotalChildrenInput" />
                        <div class="form-text">
                            Tổng trẻ em phải lớn hơn hoặc bằng 0.
                        </div>
                        <span asp-validation-for="TotalChildren" class="text-danger"></span>
                    </div>
                </div>

                <div class="table-responsive booking-create-room-table-wrap">
                    <table class="table align-middle mb-0 booking-create-room-table">
                        <thead>
                            <tr>
                                <th style="min-width:220px">Loại phòng</th>
                                <th class="text-center" style="width:120px">Phòng có thể đặt</th>
                                <th style="width:130px">Số phòng</th>
                                <th class="text-end" style="width:170px">Giá / đêm</th>
                                <th class="text-end" style="width:190px">Tiền cọc / phòng / toàn kỳ</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (var i = 0; i < Model.RoomSelections.Count; i++)
                            {
                                var room = Model.RoomSelections[i];

                                <tr data-room-type-row="@i"
                                    data-price="@room.PricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-deposit="@room.DepositPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <td>
                                        <input type="hidden"
                                               name="RoomSelections[@i].RoomTypeId"
                                               value="@room.RoomTypeId" />

                                        <div class="fw-semibold booking-breakable">
                                            @room.RoomTypeCode · @room.RoomTypeName
                                        </div>

                                        <div class="small text-body-secondary mt-1">
                                            Tối đa / phòng:
                                            @room.MaxAdults NL · @room.MaxChildren TE
                                            <span class="ms-1">
                                                · Cọc @room.DepositPercent.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))%
                                            </span>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge text-bg-gray-dark border text-body booking-availability-badge">
                                            @room.AvailableRoomCount.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))
                                        </span>
                                    </td>

                                    <td>
                                        <input class="form-control booking-quantity-input"
                                               type="number"
                                               min="0"
                                               max="999"
                                               name="RoomSelections[@i].Quantity"
                                               value="@room.Quantity"
                                               data-room-input="quantity"
                                               aria-label="Số phòng @room.RoomTypeCode" />

                                        <span class="text-danger field-validation-message"
                                              data-error-for="RoomSelections[@i].Quantity"></span>
                                    </td>

                                    <td class="text-end text-nowrap">
                                        <span class="fw-semibold booking-room-night-price">
                                            @room.PricePerNight.ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫
                                        </span>
                                    </td>

                                    <td class="text-end text-nowrap">
                                        <span class="fw-semibold">
                                            @((room.PricePerNight * Model.Nights * room.DepositPercent / 100m).ToString("#,##0.##", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))) ₫
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                        <tfoot>
                            <tr class="table-light">
                                <td colspan="2" class="fw-semibold">
                                    Tổng số phòng
                                    <div class="small text-dark fw-bold mt-1">
                                        Số đêm: <span id="step1Nights" class="fw-semibold">@Model.Nights.ToString("N0")</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <span id="step1RoomCount" class="fw-semibold">@Model.RoomSelections.Sum(x => x.Quantity) phòng</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span class="small text-dark fw-bold">Tiền phòng:</span>
                                    <span id="step1Estimate" class="fw-semibold">@Model.EstimatedRoomAmount.ToString("N0") ₫</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span class="small text-dark fw-bold">Tổng tiền cọc:</span>
                                    <span id="step1Deposit" class="fw-semibold">@Model.DepositAmount.ToString("N0") ₫</span>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </section>

        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mb-4">
            <a asp-controller="Booking"
               asp-action="CancelCreate"
               asp-route-draftId="@Model.DraftId"
               class="btn btn-outline-secondary">
                Hủy
            </a>

            <button type="submit"
                    class="btn btn-primary booking-create-next-btn">
                <span class="ui-button-content">
                    <i class="bi bi-arrow-right-circle me-1" aria-hidden="true"></i>
                    Kiểm tra khả năng &amp; sang bước 2
                </span>
                <span class="ui-button-loading d-none">
                    <span class="spinner-border spinner-border-sm me-1"
                          role="status"
                          aria-hidden="true"></span>
                    Đang kiểm tra khả năng...
                </span>
            </button>
        </div>
    </form>
    }

    @if (isStep2)
    {
    <form action="@Url.Action("Create", "Booking", new { draftId = Model.DraftId })"
          method="post"
          id="bookingCreateFinalForm"
          data-booking-create-form="final"
          data-ajax="false"
          novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DraftId" />

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="booking-create-section-icon">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h2 class="h6 mb-0 fw-semibold">Kết quả bước 1</h2>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <div class="booking-create-summary-item">
                            <div class="booking-create-summary-label">Check in dự kiến</div>
                            <div class="booking-create-summary-value">
                                @Model.CheckInDate.ToString("dd/MM/yyyy")
                                @Model.DefaultCheckInTime.ToString("HH\\:mm")
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <div class="booking-create-summary-item">
                            <div class="booking-create-summary-label">Check out dự kiến</div>
                            <div class="booking-create-summary-value">
                                @Model.CheckOutDate.ToString("dd/MM/yyyy")
                                @Model.DefaultCheckOutTime.ToString("HH\\:mm")
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-2">
                        <div class="booking-create-summary-item">
                            <div class="booking-create-summary-label">Số đêm</div>
                            <div class="booking-create-summary-value">@Model.Nights.ToString("N0")</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-2">
                        <div class="booking-create-summary-item">
                            <div class="booking-create-summary-label">Người lớn</div>
                            <div class="booking-create-summary-value">@Model.TotalAdults</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-2">
                        <div class="booking-create-summary-item">
                            <div class="booking-create-summary-label">Trẻ em</div>
                            <div class="booking-create-summary-value">@Model.TotalChildren</div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive mt-4 booking-create-room-summary-wrap">
                    <table class="table table-sm align-middle mb-0 booking-create-room-summary">
                        <thead>
                            <tr>
                                <th>Loại phòng</th>
                                <th class="text-center">Số phòng</th>
                                <th class="text-end">Giá / đêm</th>
                                <th class="text-end">Tiền cọc</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var room in Model.RoomSelections.Where(x => x.Quantity > 0))
                            {
                                var roomDepositAmount = Math.Round(
                                    room.Quantity * room.PricePerNight * Model.Nights * room.DepositPercent / 100m,
                                    2,
                                    MidpointRounding.AwayFromZero);
                                <tr>
                                    <td class="booking-breakable">
                                        <span class="font-monospace">@room.RoomTypeCode</span>
                                        · @room.RoomTypeName
                                    </td>
                                    <td class="text-center">@room.Quantity</td>
                                    <td class="text-end text-nowrap">@room.PricePerNight.ToString("N0") ₫</td>
                                    <td class="text-end text-nowrap">@roomDepositAmount.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-3">
                    <a asp-controller="Booking"
                       asp-action="Create"
                       asp-route-bookingType="0"
                       asp-route-step="1"
                       asp-route-draftId="@Model.DraftId"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                        Thay đổi phòng/ngày
                    </a>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="booking-create-section-icon">
                        <i class="bi bi-card-checklist" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h2 class="h6 mb-0 fw-semibold">Thông tin đặt phòng</h2>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <input type="hidden" asp-for="BookingType" value="0" />
                    <div class="col-12 col-md-6">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <label asp-for="BookingCode" class="form-label fw-semibold mb-0">
                                Mã đặt phòng
                            </label>
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm"
                                    id="generateBookingCodeButton">
                                <i class="bi bi-magic me-1" aria-hidden="true"></i>
                                Tự sinh mã
                            </button>
                        </div>
                        <input asp-for="BookingCode"
                               class="form-control font-monospace"
                               maxlength="50"
                               autocomplete="off"
                               pattern="[A-Za-z0-9]+"
                               title="Chỉ được chứa chữ hoa, chữ thường và số."
                               required />
                        <div class="form-text">
                            Chỉ gồm chữ hoa, chữ thường và số; không dấu cách/ký tự đặc biệt; không được trùng.
                        </div>
                        <span asp-validation-for="BookingCode" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Khoảng lưu trú</label>
                        <div class="form-control bg-body-tertiary booking-readonly-value">
                            @Model.CheckInDate.ToString("dd/MM/yyyy") @Model.DefaultCheckInTime.ToString("HH\\:mm")
                            <span class="mx-1">→</span>
                            @Model.CheckOutDate.ToString("dd/MM/yyyy") @Model.DefaultCheckOutTime.ToString("HH\\:mm")
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="BookingNote" class="form-label fw-semibold">
                            Ghi chú Booking
                        </label>
                        <textarea asp-for="BookingNote"
                                  class="form-control"
                                  rows="3"
                                  maxlength="255"
                                  placeholder="Nhập ghi chú nếu có..."></textarea>
                        <span asp-validation-for="BookingNote" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="booking-create-section-icon">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h2 class="h6 mb-0 fw-semibold">Thông tin khách hàng</h2>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <label asp-for="GuestCode" class="form-label fw-semibold mb-0">
                                Mã khách hàng <span class="text-danger">*</span>
                            </label>
                            <button type="button"
                                    class="btn btn-outline-primary btn-sm"
                                    id="generateGuestCodeButton">
                                <i class="bi bi-magic me-1" aria-hidden="true"></i>
                                Tự sinh mã
                            </button>
                        </div>
                        <input asp-for="GuestCode"
                               id="guestCode"
                               class="form-control font-monospace"
                               pattern="[A-Za-z0-9]+"
                               title="Chỉ được chứa chữ hoa, chữ thường và số."
                               maxlength="50"
                               autocomplete="off"
                               required />
                        <div class="form-text">Chỉ gồm chữ hoa, chữ thường và số; không dấu cách/ký tự đặc biệt; không được trùng.</div>
                        <span asp-validation-for="GuestCode" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="GuestName" class="form-label fw-semibold">
                            Tên khách hàng <span class="text-danger">*</span>
                        </label>
                        <input asp-for="GuestName"
                               id="guestName"
                               class="form-control"
                               maxlength="100"
                               autocomplete="name"
                               required />
                        <span asp-validation-for="GuestName" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="GuestDateOfBirth" class="form-label fw-semibold">Ngày sinh</label>
                        <input asp-for="GuestDateOfBirth" id="guestDob" type="date" class="form-control" />
                        <span asp-validation-for="GuestDateOfBirth" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="GuestSex" class="form-label fw-semibold">Giới tính</label>
                        <select asp-for="GuestSex" id="guestSex" class="form-select">
                            <option value="">-- Không nhập --</option>
                            <option value="0">Nam</option>
                            <option value="1">Nữ</option>
                            <option value="2">Khác</option>
                        </select>
                        <span asp-validation-for="GuestSex" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="GuestAddress" class="form-label fw-semibold">Địa chỉ</label>
                        <input asp-for="GuestAddress" id="guestAddress" class="form-control" maxlength="255" autocomplete="street-address" />
                        <span asp-validation-for="GuestAddress" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="GuestPhoneNumber" class="form-label fw-semibold">Số điện thoại</label>
