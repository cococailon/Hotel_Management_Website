@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            "use strict";

            const money = value =>
                new Intl.NumberFormat("vi-VN").format(
                    Math.round(Number(value || 0))
                ) + " ₫";

            const dateDiff = (a, b) => {
                if (!a || !b) {
                    return 0;
                }

                const start = new Date(a + "T00:00:00");
                const end = new Date(b + "T00:00:00");
                const diff = Math.round((end - start) / 86400000);
                return diff > 0 ? diff : 0;
            };

            const stepOneForm = document.getElementById("bookingStepOneForm");
            const refreshButton = document.getElementById("refreshCreateRoomTypesButton");

            const updateStepOneSummary = () => {
                if (!stepOneForm) {
                    return;
                }

                let rooms = 0;
                let estimate = 0;
                let deposit = 0;

                const nights = dateDiff(
                    stepOneForm.querySelector('[name="CheckInDate"]')?.value,
                    stepOneForm.querySelector('[name="CheckOutDate"]')?.value
                );

                stepOneForm.querySelectorAll("[data-room-type-row]").forEach(row => {
                    const quantityInput = row.querySelector('[data-room-input="quantity"]');
                    const quantity = Math.max(0, Number(quantityInput?.value || 0));
                    const price = Number(row.dataset.price || 0);
                    const depositPercent = Number(row.dataset.deposit || 0);
                    const max = Number(quantityInput?.max || 999);

                    rooms += quantity;
                    estimate += quantity * price * nights;
                    deposit += quantity * price * nights * depositPercent / 100;

                    quantityInput?.classList.toggle("is-invalid", quantity > max);
                });

                document.getElementById("step1Nights")?.replaceChildren(String(nights));
                document.getElementById("step1RoomCount")?.replaceChildren(`${rooms} phòng`);
                document.getElementById("step1Estimate")?.replaceChildren(money(estimate));
                document.getElementById("step1Deposit")?.replaceChildren(money(deposit));
            };

            if (stepOneForm) {
                let refreshTimer = null;
                let lastCheckIn = stepOneForm.querySelector('[name="CheckInDate"]')?.value || "";
                let lastCheckOut = stepOneForm.querySelector('[name="CheckOutDate"]')?.value || "";

                const checkInInput = stepOneForm.querySelector('[name="CheckInDate"]');
                const checkOutInput = stepOneForm.querySelector('[name="CheckOutDate"]');
                const serverToday = stepOneForm.dataset.serverToday || new Date().toISOString().slice(0, 10);

                const validateStayDates = () => {
                    if (!checkInInput || !checkOutInput) {
                        return false;
                    }

                    const checkIn = checkInInput.value || "";
                    const checkOut = checkOutInput.value || "";

                    checkInInput.setCustomValidity("");
                    checkOutInput.setCustomValidity("");

                    if (!checkIn) {
                        checkInInput.setCustomValidity("Vui lòng chọn ngày check in dự kiến.");
                        return false;
                    }

                    if (!checkOut) {
                        checkOutInput.setCustomValidity("Vui lòng chọn ngày check out dự kiến.");
                        return false;
                    }

                    if (checkIn < serverToday) {
                        checkInInput.setCustomValidity("Ngày check in dự kiến không được trước ngày hiện tại.");
                        return false;
                    }

                    if (checkOut <= checkIn) {
                        checkOutInput.setCustomValidity("Ngày check out phải sau ngày check in.");
                        return false;
                    }

                    return true;
                };

                const updateDateConstraints = () => {
                    if (!checkInInput || !checkOutInput) {
                        return;
                    }

                    checkInInput.min = serverToday;

                    if (checkInInput.value) {
                        const nextDay = new Date(checkInInput.value + "T00:00:00");
                        nextDay.setDate(nextDay.getDate() + 1);
                        const nextDayIso = nextDay.toISOString().slice(0, 10);
                        checkOutInput.min = nextDayIso;
                    } else {
                        checkOutInput.removeAttribute("min");
                    }
                };

                const scheduleAvailabilityRefresh = () => {
                    // Quan trọng: validate 2 ngày trước. Nếu ngày không hợp lệ,
                    // tuyệt đối không gửi request RefreshCreate.
                    updateDateConstraints();

                    const validDates = validateStayDates();
                    if (!validDates) {
                        clearTimeout(refreshTimer);
                        return;
                    }

                    const checkIn = checkInInput.value || "";
                    const checkOut = checkOutInput.value || "";

                    if (checkIn === lastCheckIn && checkOut === lastCheckOut) {
                        return;
                    }

                    clearTimeout(refreshTimer);
                    refreshTimer = setTimeout(() => {
                        // Kiểm tra lại ngay trước khi gửi request để tránh trường hợp
                        // người dùng sửa tiếp giá trị trong thời gian debounce.
                        if (!validateStayDates()) {
                            return;
                        }

                        lastCheckIn = checkInInput.value || "";
                        lastCheckOut = checkOutInput.value || "";

                        if (refreshButton) {
                            refreshButton.click();
                        }
                    }, 350);
                };

                checkInInput?.addEventListener("change", scheduleAvailabilityRefresh);
                checkOutInput?.addEventListener("change", scheduleAvailabilityRefresh);
                checkInInput?.addEventListener("blur", validateStayDates);
                checkOutInput?.addEventListener("blur", validateStayDates);
                checkInInput?.addEventListener("input", updateDateConstraints);
                checkOutInput?.addEventListener("input", updateDateConstraints);

                updateDateConstraints();
                validateStayDates();

                stepOneForm.addEventListener("input", updateStepOneSummary);
                stepOneForm.addEventListener("change", updateStepOneSummary);

                stepOneForm.addEventListener("submit", event => {
                    if (event.submitter === refreshButton) {
                        return;
                    }

                    if (!stepOneForm.checkValidity()) {
                        event.preventDefault();
                        stepOneForm.reportValidity();
                        return;
                    }

                    const submitButton = event.submitter;
                    if (submitButton && window.HotelUI?.setButtonLoading) {
                        window.HotelUI.setButtonLoading(
                            submitButton,
                            true,
                            "Đang kiểm tra..."
                        );
                    }
                });

                updateStepOneSummary();

                // Khi POST bước 1 trả lại trang vì lỗi sức chứa tổng người,
                // ưu tiên cuộn tới đúng trường đang có lỗi thay vì để trang đứng ở đầu.
                const scrollToStepOneCapacityError = () => {
                    const errorSelectors = [
                        '[data-valmsg-for="TotalAdults"].field-validation-error',
                        '[data-valmsg-for="TotalChildren"].field-validation-error'
                    ];

                    for (const selector of errorSelectors) {
                        const validationMessage = document.querySelector(selector);
                        if (!validationMessage || !validationMessage.textContent?.trim()) {
                            continue;
                        }

                        const field = document.querySelector(
                            validationMessage.dataset.valmsgFor === "TotalAdults"
                                ? "#step1TotalAdultsInput"
                                : "#step1TotalChildrenInput"
                        );

                        const target = field?.closest(".col-12.col-md-6") || validationMessage;

                        window.requestAnimationFrame(() => {
                            window.requestAnimationFrame(() => {
                                target.scrollIntoView({
                                    behavior: "smooth",
                                    block: "center"
                                });
                            });
                        });

                        return;
                    }
                };

                scrollToStepOneCapacityError();
            }
        })();
    </script>

    <script>
        (() => {
            "use strict";

            const finalForm = document.getElementById("bookingCreateFinalForm");
            if (!finalForm) {
                return;
            }

            const bookingCode = document.getElementById("BookingCode");
            const guestCode = document.getElementById("guestCode");
            const guestName = document.getElementById("guestName");
            const guestDob = document.getElementById("guestDob");
            const guestSex = document.getElementById("guestSex");
            const guestAddress = document.getElementById("guestAddress");
            const guestPhone = document.getElementById("guestPhone");
            const guestEmail = document.getElementById("guestEmail");
            const guestIdentityNumber = document.getElementById("guestIdentityNumber");
            const guestIdentityType = document.getElementById("guestIdentityType");
            const guestNote = document.getElementById("guestNote");
            const bookingNote = document.getElementById("BookingNote");
            const transferRadio = document.getElementById("paymentTransfer");
            const cashRadio = document.getElementById("paymentCash");
            const referenceWrap = document.getElementById("referenceCodeWrap");
            const referenceInput = document.getElementById("referenceCode");
            const paymentDate = document.getElementById("paymentDate");
            const depositConfirmed = document.getElementById("depositConfirmed");
            const depositAmount = Number("@Model.DepositAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)");

            const serverErrorSnapshots = new Map();

            const getMessageElement = input => {
                if (!input?.name) return null;
                return finalForm.querySelector(`[data-valmsg-for="${CSS.escape(input.name)}"]`);
            };

            const getValue = input => {
                if (!input) return "";
                if (input.type === "checkbox" || input.type === "radio") {
                    return input.checked ? "true" : "false";
                }
                return String(input.value ?? "");
            };

            const setFieldError = (input, message) => {
                if (!input) return;
                const messageElement = getMessageElement(input);
                input.classList.add("is-invalid");
                input.setAttribute("aria-invalid", "true");
                if (messageElement) {
                    messageElement.textContent = message;
                    messageElement.classList.remove("field-validation-valid");
                    messageElement.classList.add("field-validation-error");
                }
            };

            const clearFieldError = input => {
                if (!input) return;
                const messageElement = getMessageElement(input);
                input.classList.remove("is-invalid");
                input.removeAttribute("aria-invalid");
                if (messageElement) {
                    messageElement.textContent = "";
                    messageElement.classList.remove("field-validation-error");
                    messageElement.classList.add("field-validation-valid");
                }
            };

            const isValidCode = value => /^[A-Za-z0-9]+$/.test(value);

            const validateCode = (input, label) => {
                const value = input?.value.trim() ?? "";
                if (!value) {
                    setFieldError(input, `${label} không được để trống.`);
                    return false;
                }
                if (!isValidCode(value)) {
                    setFieldError(input, `${label} chỉ được bao gồm chữ hoa, chữ thường và số, không chứa dấu cách và ký tự đặc biệt.`);
                    return false;
                }
                if (value.length > 50) {
                    setFieldError(input, `${label} không được vượt quá 50 ký tự.`);
                    return false;
                }
                clearFieldError(input);
                return true;
            };

            const validateOptionalMax = (input, label, max) => {
                const value = input?.value.trim() ?? "";
                if (value.length > max) {
                    setFieldError(input, `${label} không được vượt quá ${max} ký tự.`);
                    return false;
                }
                clearFieldError(input);
                return true;
            };

            const validateStep2FrontEnd = () => {
                const orderedChecks = [
                    () => validateCode(bookingCode, "Mã đặt phòng"),
                    () => validateOptionalMax(bookingNote, "Ghi chú Booking", 255),
                    () => validateCode(guestCode, "Mã khách hàng"),
                    () => {
                        const value = guestName?.value.trim() ?? "";
                        if (!value) {
                            setFieldError(guestName, "Tên khách hàng không được để trống.");
                            return false;
                        }
                        if (value.length > 100) {
                            setFieldError(guestName, "Tên khách hàng không được vượt quá 100 ký tự.");
                            return false;
                        }
                        clearFieldError(guestName);
                        return true;
                    },
                    () => {
                        const value = guestDob?.value ?? "";
                        if (!value) {
                            clearFieldError(guestDob);
                            return true;
                        }
                        const date = new Date(`${value}T00:00:00`);
                        const today = new Date();
                        today.setHours(0, 0, 0, 0);
                        if (Number.isNaN(date.getTime()) || date > today) {
                            setFieldError(guestDob, "Ngày sinh không được lớn hơn ngày hiện tại.");
                            return false;
                        }
                        clearFieldError(guestDob);
                        return true;
                    },
                    () => {
                        const value = guestSex?.value ?? "";
                        if (value !== "" && !["0", "1", "2"].includes(value)) {
                            setFieldError(guestSex, "Giới tính khách hàng không hợp lệ.");
                            return false;
                        }
                        clearFieldError(guestSex);
                        return true;
                    },
                    () => validateOptionalMax(guestAddress, "Địa chỉ", 255),
                    () => {
                        const value = guestPhone?.value.trim() ?? "";
                        const emailValue = guestEmail?.value.trim() ?? "";

                        if (!value && !emailValue) {
                            setFieldError(guestPhone, "Khách hàng phải có ít nhất số điện thoại hoặc email.");
                            setFieldError(guestEmail, "Khách hàng phải có ít nhất số điện thoại hoặc email.");
                            return false;
                        }

                        if (!value) {
                            clearFieldError(guestPhone);
                            return true;
                        }

                        // Chấp nhận số điện thoại quốc tế và các cách ghi phổ biến:
                        // +84 912345678, +1 (202) 555-0123, 0084 912345678...
                        // Sau khi bỏ khoảng trắng, dấu chấm, gạch ngang, ngoặc:
                        // số phải có 7-15 chữ số, phù hợp giới hạn đánh số quốc tế.
                        let normalized = value.replace(/[\s().-]/g, "");
                        if (normalized.startsWith("00")) {
                            normalized = "+" + normalized.slice(2);
                        }

                        const valid = normalized.startsWith("+")
                            ? /^\+[1-9][0-9]{6,14}$/.test(normalized)
                            : /^[0-9]{7,15}$/.test(normalized);

                        if (!valid) {
                            setFieldError(
                                guestPhone,
                                "Số điện thoại không hợp lệ. Có thể nhập số quốc tế; sau khi chuẩn hóa phải có 7-15 chữ số."
                            );
                            return false;
                        }

                        if (value.length > 30) {
                            setFieldError(guestPhone, "Số điện thoại nhập vào không được vượt quá 30 ký tự.");
                            return false;
                        }

                        clearFieldError(guestPhone);
                        return true;
                    },
                    () => {
                        const value = guestEmail?.value.trim() ?? "";
                        if (!value) {
                            clearFieldError(guestEmail);
                            return true;
                        }

                        if (
                            value.length > 254 ||
                            !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value)
                        ) {
                            setFieldError(guestEmail, "Email không đúng định dạng.");
                            return false;
                        }

                        clearFieldError(guestEmail);
                        return true;
                    },
                    () => {
                        const value = guestIdentityNumber?.value.trim() ?? "";
                        const type = guestIdentityType?.value ?? "";

                        if (!value) {
                            clearFieldError(guestIdentityNumber);
                            return true;
                        }

                        if (value.length > 50) {
                            setFieldError(guestIdentityNumber, "Số giấy tờ không được vượt quá 50 ký tự.");
                            return false;
                        }

                        if (!["0", "1", "2"].includes(type)) {
                            setFieldError(
                                guestIdentityType,
                                "Vui lòng chọn loại giấy tờ khi nhập số giấy tờ."
                            );
                            return false;
                        }

                        switch (type) {
                            case "0":
                                if (!/^\d{12}$/.test(value)) {
                                    setFieldError(
                                        guestIdentityNumber,
                                        "CCCD phải gồm đúng 12 chữ số."
                                    );
                                    return false;
                                }
                                break;

                            case "1":
                                if (!/^\d{12}$/.test(value)) {
                                    setFieldError(
                                        guestIdentityNumber,
                                        "Giấy phép lái xe phải gồm đúng 12 chữ số."
                                    );
                                    return false;
                                }
                                break;

                            case "2":
                                if (!/^[A-Za-z0-9]{5,20}$/.test(value)) {
                                    setFieldError(
                                        guestIdentityNumber,
                                        "Hộ chiếu phải gồm 5-20 ký tự chữ và số, không chứa dấu cách hoặc ký tự đặc biệt."
                                    );
                                    return false;
                                }
                                break;
                        }

                        clearFieldError(guestIdentityNumber);
                        clearFieldError(guestIdentityType);
                        return true;
                    },
                    () => {
                        const number = guestIdentityNumber?.value.trim() ?? "";
                        const type = guestIdentityType?.value ?? "";

                        if (number && !["0", "1", "2"].includes(type)) {
                            setFieldError(
                                guestIdentityType,
                                "Vui lòng chọn loại giấy tờ khi nhập số giấy tờ."
                            );
                            return false;
                        }

                        if (type && !["0", "1", "2"].includes(type)) {
                            setFieldError(
                                guestIdentityType,
                                "Loại giấy tờ khách hàng không hợp lệ."
                            );
                            return false;
                        }

                        clearFieldError(guestIdentityType);
                        return true;
                    },
                    () => validateOptionalMax(guestNote, "Ghi chú khách hàng", 255),
                    () => {
                        if (depositAmount <= 0) {
                            clearFieldError(cashRadio);
                            return true;
                        }
                        if (!cashRadio?.checked && !transferRadio?.checked) {
                            setFieldError(cashRadio, "Vui lòng chọn phương thức thanh toán tiền cọc.");
                            return false;
                        }
                        clearFieldError(cashRadio);
                        clearFieldError(transferRadio);
                        return true;
                    },
                    () => {
                        if (depositAmount <= 0) {
                            return true;
                        }
                        if (!paymentDate?.value) {
                            setFieldError(paymentDate, "Vui lòng chọn thời gian thanh toán tiền cọc.");
                            return false;
                        }
                        const payment = new Date(paymentDate.value);
                        const step2Start = paymentDate.dataset.step2Start
                            ? new Date(paymentDate.dataset.step2Start)
                            : null;
                        if (step2Start && payment < step2Start) {
                            setFieldError(paymentDate, "Thời gian thanh toán tiền cọc không được trước thời điểm bắt đầu bước 2.");
                            return false;
                        }
                        if (payment > new Date()) {
                            setFieldError(paymentDate, "Thời gian thanh toán tiền cọc không được lớn hơn thời điểm submit bước 2.");
                            return false;
                        }
                        clearFieldError(paymentDate);
                        return true;
                    },
                    () => {
                        if (depositAmount <= 0) return true;
                        if (!depositConfirmed?.checked) {
                            setFieldError(depositConfirmed, "Vui lòng xác nhận đã nhận được tiền cọc.");
                            return false;
                        }
                        clearFieldError(depositConfirmed);
                        return true;
                    },
                    () => {
                        if (depositAmount <= 0 || !transferRadio?.checked) return true;
                        const value = referenceInput?.value.trim() ?? "";
                        if (!value) {
                            setFieldError(referenceInput, "Mã giao dịch là bắt buộc khi thanh toán chuyển khoản.");
                            return false;
                        }
                        if (value.length > 100) {
                            setFieldError(referenceInput, "Mã giao dịch không được vượt quá 100 ký tự.");
                            return false;
                        }
                        clearFieldError(referenceInput);
                        return true;
                    }
                ];

                let firstInvalid = null;
                for (const check of orderedChecks) {
                    const valid = check();
                    if (!valid && !firstInvalid) {
                        const candidates = finalForm.querySelectorAll(".is-invalid");
                        firstInvalid = candidates.length > 0 ? candidates[0] : null;
                    }
                }

                // Có thể cả Phone + Email cùng lỗi. Lấy phần tử sớm nhất theo DOM.
                const invalids = Array.from(finalForm.querySelectorAll(".is-invalid"));
                if (invalids.length > 0) {
                    firstInvalid = invalids[0];
                }

                if (firstInvalid) {
                    focusAndScroll(firstInvalid);
                    return false;
                }

                return true;
            };

            const focusAndScroll = element => {
                if (!element) return;
                window.requestAnimationFrame(() => {
                    element.scrollIntoView({ behavior: "smooth", block: "center" });
                    window.setTimeout(() => {
                        try {
                            element.focus({ preventScroll: true });
                        } catch {
                            element.focus();
                        }
                    }, 250);
                });
            };

            const clearServerErrorIfChanged = input => {
                if (!input) return;
                const snapshot = serverErrorSnapshots.get(input);
                if (snapshot === undefined) return;
                if (getValue(input) !== snapshot) {
                    serverErrorSnapshots.delete(input);
                    clearFieldError(input);
                }
            };

            const captureServerErrors = () => {
                const messages = Array.from(finalForm.querySelectorAll("[data-valmsg-for]"));
                let firstErrorInput = null;
                for (const message of messages) {
                    const text = message.textContent?.trim() || "";
                    if (!text) continue;
                    const fieldName = message.getAttribute("data-valmsg-for");
                    const input = finalForm.querySelector(`[name="${CSS.escape(fieldName)}"]`);
                    if (!input || input.type === "hidden") continue;
                    serverErrorSnapshots.set(input, getValue(input));
                    input.classList.add("is-invalid");
                    input.setAttribute("aria-invalid", "true");
                    message.classList.remove("field-validation-valid");
                    message.classList.add("field-validation-error");
                    if (!firstErrorInput) firstErrorInput = input;
                }
                if (firstErrorInput) {
                    focusAndScroll(firstErrorInput);
                }
            };

            const validateLivePhone = () => {
                const value = guestPhone?.value.trim() ?? "";
                const emailValue = guestEmail?.value.trim() ?? "";
                if (!value) {
                    if (!emailValue) {
                        setFieldError(guestPhone, "Khách hàng phải có ít nhất số điện thoại hoặc email.");
                        setFieldError(guestEmail, "Khách hàng phải có ít nhất số điện thoại hoặc email.");
                        return false;
                    }
                    clearFieldError(guestPhone);
                    return true;
                }

                let normalized = value.replace(/[\s().-]/g, "");
                if (normalized.startsWith("00")) normalized = "+" + normalized.slice(2);
                const valid = normalized.startsWith("+")
                    ? /^\+[1-9][0-9]{6,14}$/.test(normalized)
                    : /^[0-9]{7,15}$/.test(normalized);

                if (!valid) {
                    setFieldError(guestPhone, "Số điện thoại không hợp lệ. Có thể nhập số quốc tế; sau khi chuẩn hóa phải có 7-15 chữ số.");
                    return false;
                }
                if (value.length > 30) {
                    setFieldError(guestPhone, "Số điện thoại nhập vào không được vượt quá 30 ký tự.");
                    return false;
                }
                clearFieldError(guestPhone);
                if (!emailValue) clearFieldError(guestEmail);
                return true;
            };

            const validateLiveEmail = () => {
                const value = guestEmail?.value.trim() ?? "";
                if (!value) {
                    clearFieldError(guestEmail);
                    if (!guestPhone?.value.trim()) {
                        setFieldError(guestPhone, "Khách hàng phải có ít nhất số điện thoại hoặc email.");
                        return false;
                    }
                    return true;
                }
                if (value.length > 254 || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value)) {
                    setFieldError(guestEmail, "Email không đúng định dạng hoặc vượt quá 254 ký tự.");
                    return false;
                }
                clearFieldError(guestEmail);
                if (!guestPhone?.value.trim()) clearFieldError(guestPhone);
                return true;
            };

            const validateLiveIdentity = () => {
                const number = guestIdentityNumber?.value.trim() ?? "";
                const type = guestIdentityType?.value ?? "";
                if (!number) {
                    clearFieldError(guestIdentityNumber);
                    clearFieldError(guestIdentityType);
                    return true;
                }
                if (!['0', '1', '2'].includes(type)) {
                    setFieldError(guestIdentityType, "Vui lòng chọn loại giấy tờ khi nhập số giấy tờ.");
                    return false;
                }
                if (number.length > 50) {
                    setFieldError(guestIdentityNumber, "Số giấy tờ không được vượt quá 50 ký tự.");
                    return false;
                }
                if (type === "0" && !/^\d{12}$/.test(number)) {
                    setFieldError(guestIdentityNumber, "CCCD phải gồm đúng 12 chữ số.");
                    return false;
                }
                if (type === "1" && !/^\d{12}$/.test(number)) {
                    setFieldError(guestIdentityNumber, "Giấy phép lái xe phải gồm đúng 12 chữ số.");
                    return false;
                }
                if (type === "2" && !/^[A-Za-z0-9]{5,20}$/.test(number)) {
                    setFieldError(guestIdentityNumber, "Hộ chiếu phải gồm 5-20 ký tự chữ và số, không chứa dấu cách hoặc ký tự đặc biệt.");
                    return false;
                }
                clearFieldError(guestIdentityNumber);
                clearFieldError(guestIdentityType);
                return true;
            };

            const validateLivePaymentDate = () => {
                if (depositAmount <= 0) {
                    clearFieldError(paymentDate);
                    return true;
                }
                if (!paymentDate?.value) {
                    setFieldError(paymentDate, "Vui lòng chọn thời gian thanh toán tiền cọc.");
                    return false;
                }
                const payment = new Date(paymentDate.value);
                const step2Start = paymentDate.dataset.step2Start ? new Date(paymentDate.dataset.step2Start) : null;
                if (step2Start && payment < step2Start) {
                    setFieldError(paymentDate, "Thời gian thanh toán tiền cọc không được trước thời điểm bắt đầu bước 2.");
                    return false;
                }
                if (payment > new Date()) {
                    setFieldError(paymentDate, "Thời gian thanh toán tiền cọc không được lớn hơn thời điểm hiện tại.");
                    return false;
                }
                clearFieldError(paymentDate);
                return true;
            };

            const validateLiveReference = () => {
                if (depositAmount <= 0 || !transferRadio?.checked) {
                    clearFieldError(referenceInput);
                    return true;
                }
                const value = referenceInput?.value.trim() ?? "";
                if (!value) {
                    setFieldError(referenceInput, "Mã giao dịch là bắt buộc khi thanh toán chuyển khoản.");
                    return false;
                }
                if (value.length > 100) {
                    setFieldError(referenceInput, "Mã giao dịch không được vượt quá 100 ký tự.");
                    return false;
                }
                clearFieldError(referenceInput);
                return true;
            };

            const validateLiveName = () => {
                const value = guestName?.value.trim() ?? "";
                if (!value) {
                    setFieldError(guestName, "Tên khách hàng không được để trống.");
                    return false;
                }
                if (value.length > 100) {
                    setFieldError(guestName, "Tên khách hàng không được vượt quá 100 ký tự.");
                    return false;
                }
                clearFieldError(guestName);
                return true;
            };

            const validateLiveCode = (input, label) => validateCode(input, label);

            const updateReferenceVisibility = () => {
                const show = Boolean(transferRadio?.checked);

                referenceWrap?.classList.toggle("d-none", !show);

                if (referenceInput) {
                    referenceInput.required = show;

                    // Nếu chuyển từ Chuyển khoản sang Tiền mặt,
                    // lỗi "Mã giao dịch bắt buộc" không còn áp dụng nữa.
                    // Phải xóa cả lỗi hiển thị và snapshot lỗi server,
                    // nếu không validateStep2FrontEnd() vẫn thấy referenceInput.is-invalid
                    // và sẽ chặn modal xác nhận.
                    if (!show) {
                        serverErrorSnapshots.delete(referenceInput);
                        clearFieldError(referenceInput);
                        referenceInput.setCustomValidity("");
                    }
                }
            };

            const requestGeneratedCode = async (url, input, title) => {
                if (!input) return;
                try {
                    const response = await fetch(url, {
                        method: "GET",
                        headers: { "Accept": "application/json" },
                        credentials: "same-origin"
                    });
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }
                    const data = await response.json();
                    if (!data?.code) {
                        throw new Error("Mã trả về không hợp lệ.");
                    }
                    input.value = data.code;
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                    input.dispatchEvent(new Event("change", { bubbles: true }));
                    serverErrorSnapshots.delete(input);
                    clearFieldError(input);
                } catch (error) {
                    console.error(error);
                    window.HotelUI?.toast?.("danger", title, `Không thể tự sinh mã. Vui lòng thử lại.`);
                }
            };

            updateReferenceVisibility();

            document.querySelectorAll('input[name="PaymentMethod"]').forEach(input => {
                input.addEventListener("change", updateReferenceVisibility);
            });

            const generateBookingCodeButton = document.getElementById("generateBookingCodeButton");
            const generateGuestCodeButton = document.getElementById("generateGuestCodeButton");

            generateBookingCodeButton?.addEventListener("click", () =>
                requestGeneratedCode(
                    "@Url.Action("GetNextBookingCode", "Booking")",
                    bookingCode,
                    "Tự sinh mã đặt phòng"
                ));

            generateGuestCodeButton?.addEventListener("click", () =>
                requestGeneratedCode(
                    "@Url.Action("GetNextGuestCode", "Booking")",
                    guestCode,
                    "Tự sinh mã khách hàng"
                ));

            [
                bookingCode, bookingNote, guestCode, guestName, guestDob, guestSex,
                guestAddress, guestPhone, guestEmail, guestIdentityNumber,
                guestIdentityType, guestNote, cashRadio, transferRadio,
                paymentDate, depositConfirmed, referenceInput
            ].filter(Boolean).forEach(input => {
                input.addEventListener("input", () => clearServerErrorIfChanged(input));
                input.addEventListener("change", () => clearServerErrorIfChanged(input));
                input.addEventListener("focusout", () => clearServerErrorIfChanged(input), true);
            });

            bookingCode?.addEventListener("input", () => validateLiveCode(bookingCode, "Mã đặt phòng"));
            bookingNote?.addEventListener("input", () => validateOptionalMax(bookingNote, "Ghi chú Booking", 255));
            guestCode?.addEventListener("input", () => validateLiveCode(guestCode, "Mã khách hàng"));
            guestName?.addEventListener("input", validateLiveName);
            guestDob?.addEventListener("input", () => {
                const value = guestDob.value;
                if (!value) { clearFieldError(guestDob); return; }
                const date = new Date(`${value}T00:00:00`);
                const today = new Date();
                today.setHours(0,0,0,0);
                if (Number.isNaN(date.getTime()) || date > today) setFieldError(guestDob, "Ngày sinh không được lớn hơn ngày hiện tại.");
                else clearFieldError(guestDob);
            });
            guestSex?.addEventListener("change", () => {
                if (guestSex.value && !["0","1","2"].includes(guestSex.value)) setFieldError(guestSex, "Giới tính khách hàng không hợp lệ.");
                else clearFieldError(guestSex);
            });
            guestAddress?.addEventListener("input", () => validateOptionalMax(guestAddress, "Địa chỉ", 255));
            guestPhone?.addEventListener("input", validateLivePhone);
            guestEmail?.addEventListener("input", validateLiveEmail);
            guestIdentityNumber?.addEventListener("input", validateLiveIdentity);
            guestIdentityType?.addEventListener("change", validateLiveIdentity);
            guestNote?.addEventListener("input", () => validateOptionalMax(guestNote, "Ghi chú khách hàng", 255));
            paymentDate?.addEventListener("input", validateLivePaymentDate);
            referenceInput?.addEventListener("input", validateLiveReference);
            depositConfirmed?.addEventListener("change", () => {
                if (depositAmount <= 0 || depositConfirmed.checked) clearFieldError(depositConfirmed);
                else setFieldError(depositConfirmed, "Vui lòng xác nhận đã nhận được tiền cọc.");
            });
            [cashRadio, transferRadio].filter(Boolean).forEach(input => input.addEventListener("change", () => {
                updateReferenceVisibility();
                clearFieldError(cashRadio);
                clearFieldError(transferRadio);
                validateLiveReference();
            }));

            let confirmed = false;
            finalForm.addEventListener("submit", event => {
                if (confirmed) {
                    return;
                }

                event.preventDefault();
                updateReferenceVisibility();

                if (!validateStep2FrontEnd()) {
                    return;
                }

                const doSubmit = () => {
                    confirmed = true;
                    const button = document.getElementById("bookingCreateSubmitButton");
                    if (button && window.HotelUI?.setButtonLoading) {
                        window.HotelUI.setButtonLoading(button, true, "Đang tạo...");
                    }
                    finalForm.submit();
                };

                const confirm = window.HotelUI?.showConfirm;
                if (typeof confirm === "function") {
                    confirm({
                        title: "Xác nhận tạo lịch đặt phòng",
                        message: "Bạn có chắc chắn muốn tạo lịch đặt phòng với các thông tin hiện tại?",
                        note: depositAmount > 0
                            ? ""
                            : "",
                        variant: "primary",
                        confirmText: "Tạo lịch đặt phòng",
                        onConfirm: doSubmit
                    });
                } else {
                    doSubmit();
                }
            });

            captureServerErrors();
        })();
    </script>
}
