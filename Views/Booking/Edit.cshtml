@model Hotel_Management_Website.Models.ViewModels.Booking.BookingEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa lịch đặt phòng";
    Layout = User.IsInRole("Reception")
        ? "~/Views/Shared/_ReceptionLayout.cshtml"
        : "~/Views/Shared/_AdminLayout.cshtml";
    var pageDescription = Model.CanEditServices
        ? "Cập nhật Booking, khách hàng, ghi chú phòng, dịch vụ và phí phát sinh theo đúng trạng thái hiện tại."
        : Model.CanEditGuestDetails
            ? "Cập nhật thông tin Booking và khách hàng theo đúng quy tắc của trạng thái hiện tại."
            : Model.CanEditPeople
                ? "Cập nhật số người và ghi chú theo trạng thái của Booking; sức chứa phòng sẽ được kiểm tra lại trên máy chủ."
                : "Chỉ các trường được phép theo trạng thái hiện tại mới có thể chỉnh sửa.";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/booking-edit.css" asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Chỉnh sửa lịch đặt phòng",
        Description = pageDescription,
        Icon = "bi-pencil-square"
    })

<div class="booking-edit-page">
    <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center justify-content-between gap-2 mb-4">
        <a asp-controller="Booking" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Quay lại danh sách
        </a>

        <div class="d-flex flex-column flex-sm-row gap-2">
            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-primary">
                <i class="bi bi-eye me-1" aria-hidden="true"></i>
                Xem chi tiết
            </a>
            <span class="badge @Model.StatusBadgeClass booking-edit-status-badge align-self-start align-self-sm-center">
                @Model.StatusName
            </span>
        </div>
    </div>

    <form asp-controller="Booking"
          asp-action="Edit"
          method="post"
          id="bookingEditForm"
          autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BookingId" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger booking-edit-validation-summary @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert"></div>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2 min-width-0">
                    <div class="booking-edit-section-icon" aria-hidden="true">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="min-width-0">
                        <h2 class="h6 mb-0 fw-semibold">Thông tin lịch đặt phòng</h2>
                        <div class="small text-body-secondary">Thông tin hệ thống của Booking được giữ nguyên, chỉ các thuộc tính được phép mới có thể sửa.</div>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="booking-edit-label">Mã đặt phòng</div>
                        <div class="booking-edit-value font-monospace" title="@Model.BookingCode">@Model.BookingCode</div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="booking-edit-label">Loại</div>
                        <div class="booking-edit-value">
                            <span class="badge @Model.BookingTypeBadgeClass booking-edit-wrap-badge">@Model.BookingTypeName</span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="booking-edit-label">Check in dự tính</div>
                        <div class="booking-edit-value">@Model.ExpectedCheckInAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="booking-edit-label">Check out dự tính</div>
                        <div class="booking-edit-value">@Model.ExpectedCheckOutAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4 mb-4">
            <div class="col-12 col-xl-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-body border-bottom py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="booking-edit-section-icon" aria-hidden="true">
                                <i class="bi bi-people"></i>
                            </div>
                            <div>
                                <h2 class="h6 mb-0 fw-semibold">Thông tin số người</h2>
                                <div class="small text-body-secondary">
                                    @(Model.CanEditPeople ? "Có thể chỉnh sửa ở trạng thái hiện tại." : "Không được chỉnh sửa ở trạng thái hiện tại.")
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        @if (Model.CanEditPeople)
                        {
                            <div class="row g-3">
                                <div class="col-12 col-sm-6">
                                    <label asp-for="TotalAdults" class="form-label">Tổng người lớn</label>
                                    <input asp-for="TotalAdults" class="form-control" min="1" inputmode="numeric" />
                                    <span asp-validation-for="TotalAdults" class="text-danger small"></span>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label asp-for="TotalChildren" class="form-label">Tổng trẻ em</label>
                                    <input asp-for="TotalChildren" class="form-control" min="0" inputmode="numeric" />
                                    <span asp-validation-for="TotalChildren" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="alert alert-info py-2 px-3 mt-3 mb-0 small">
                                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                                Tổng người lớn và trẻ em không được vượt quá tổng sức chứa của các BookingRoom đã đặt. Hệ thống sẽ kiểm tra lại trên máy chủ khi lưu.
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="TotalAdults" />
                            <input type="hidden" asp-for="TotalChildren" />
                            <div class="row g-3">
                                <div class="col-12 col-sm-6">
                                    <div class="booking-edit-label">Tổng người lớn</div>
                                    <div class="booking-edit-readonly-number">@Model.TotalAdults</div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="booking-edit-label">Tổng trẻ em</div>
                                    <div class="booking-edit-readonly-number">@Model.TotalChildren</div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <div class="col-12 col-xl-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-body border-bottom py-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="booking-edit-section-icon" aria-hidden="true">
                                <i class="bi bi-sticky"></i>
                            </div>
                            <div>
                                <h2 class="h6 mb-0 fw-semibold">Ghi chú Booking</h2>
                                <div class="small text-body-secondary">Cho phép chỉnh sửa ở mọi trạng thái của Booking.</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <label asp-for="Note" class="form-label">Ghi chú</label>
                        <textarea asp-for="Note" class="form-control booking-edit-textarea" rows="5" maxlength="255" placeholder="Nhập ghi chú cho lịch đặt phòng..."></textarea>
                        <div class="d-flex justify-content-between gap-2 mt-1">
                            <span asp-validation-for="Note" class="text-danger small"></span>
                            <span class="small text-body-secondary text-nowrap">Tối đa 255 ký tự</span>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2 min-width-0">
                    <div class="booking-edit-section-icon" aria-hidden="true">
                        <i class="bi bi-person-vcard"></i>
                    </div>
                    <div class="min-width-0">
                        <h2 class="h6 mb-0 fw-semibold">Khách hàng</h2>
                        <div class="small text-body-secondary">
                            @if (Model.CanEditGuestDetails)
                            {
                                if (Model.RequireFullGuestDetails)
                                {
                                    <span>Booking đang ở trạng thái <strong>Đang ở</strong>: các thông tin khách hàng bắt buộc phải được khai báo đầy đủ theo quy định.</span>
                                }
                                else
                                {
                                    <span>Có thể chỉnh sửa thông tin khách hàng. Ngày sinh, giới tính, địa chỉ và giấy tờ được phép để trống.</span>
                                }
                            }
                            else
                            {
                                <span>Ở trạng thái hiện tại chỉ cho phép chỉnh sửa <strong>Ghi chú khách hàng</strong>. Các trường còn lại đã bị khóa.</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (string.IsNullOrWhiteSpace(Model.Guest.GuestCode) && string.IsNullOrWhiteSpace(Model.Guest.Name))
                {
                    <div class="alert alert-warning mb-0 small">
                        <i class="bi bi-person-x me-1" aria-hidden="true"></i>
                        Booking hiện không có khách hàng hợp lệ để chỉnh sửa. Vui lòng kiểm tra lại dữ liệu Booking trước khi tiếp tục.
                    </div>
                }
                else
                {
                    var guestDetailsDisabled = !Model.CanEditGuestDetails;
                    var requiredFull = Model.RequireFullGuestDetails;

                    <div class="alert alert-light border small mb-3">
                        <i class="bi bi-shield-check me-1" aria-hidden="true"></i>
                        <strong>Quyền sửa theo trạng thái:</strong>
                        @(Model.CanEditGuestDetails
                            ? (requiredFull
                                ? "Mã, tên, ngày sinh, giới tính, địa chỉ, liên hệ và giấy tờ đều được kiểm tra bắt buộc."
                                : "Mã và tên bắt buộc; phải có ít nhất Số điện thoại hoặc Email; các thông tin còn lại được phép để trống.")
                            : "Chỉ Ghi chú khách hàng được phép sửa.")
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-sm-6 col-xl-4">
                            <label asp-for="Guest.GuestCode" class="form-label">Mã khách hàng</label>
                            <input asp-for="Guest.GuestCode"
                                   class="form-control font-monospace"
                                   maxlength="50"
                                   autocomplete="off"
                                   pattern="\S+"
                                   title="Mã khách hàng không được chứa dấu cách hoặc khoảng trắng."
                                   disabled="@guestDetailsDisabled" />
                            <span asp-validation-for="Guest.GuestCode" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6 col-xl-8">
                            <label asp-for="Guest.Name" class="form-label">Tên khách hàng <span class="text-danger">*</span></label>
                            <input asp-for="Guest.Name"
                                   class="form-control"
                                   maxlength="100"
                                   autocomplete="name"
                                   required="@Model.CanEditGuestDetails"
                                   disabled="@guestDetailsDisabled" />
                            <span asp-validation-for="Guest.Name" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6 col-xl-4">
                            <label asp-for="Guest.DateOfBirth" class="form-label">Ngày sinh @(requiredFull ? Html.Raw("<span class='text-danger'>*</span>") : Html.Raw(""))</label>
                            <input asp-for="Guest.DateOfBirth"
                                   type="date"
                                   class="form-control"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required="@requiredFull"
                                   disabled="@guestDetailsDisabled" />
                            <span asp-validation-for="Guest.DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6 col-xl-4">
                            <label asp-for="Guest.Sex" class="form-label">Giới tính @(requiredFull ? Html.Raw("<span class='text-danger'>*</span>") : Html.Raw(""))</label>
                            <select asp-for="Guest.Sex"
                                    class="form-select"
                                    required="@requiredFull"
                                    disabled="@guestDetailsDisabled">
                                <option value="">-- Chọn giới tính --</option>
                                <option value="0">Nam</option>
                                <option value="1">Nữ</option>
                                <option value="2">Khác</option>
                            </select>
                            <span asp-validation-for="Guest.Sex" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-xl-4">
                            <label asp-for="Guest.Address" class="form-label">Địa chỉ @(requiredFull ? Html.Raw("<span class='text-danger'>*</span>") : Html.Raw(""))</label>
                            <input asp-for="Guest.Address"
                                   class="form-control"
                                   maxlength="255"
                                   autocomplete="street-address"
                                   required="@requiredFull"
                                   disabled="@guestDetailsDisabled" />
                            <span asp-validation-for="Guest.Address" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Guest.PhoneNumber" class="form-label">Số điện thoại</label>
                            <input asp-for="Guest.PhoneNumber"
                                   class="form-control"
                                   maxlength="20"
                                   autocomplete="tel"
                                   data-guest-phone
                                   disabled="@guestDetailsDisabled" />
                            <span asp-validation-for="Guest.PhoneNumber" class="text-danger small" data-guest-phone-error></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Guest.Email" class="form-label">Email</label>
                            <input asp-for="Guest.Email"
                                   type="email"
                                   class="form-control"
                                   maxlength="4000"
                                   autocomplete="email"
                                   data-guest-email
                                   disabled="@guestDetailsDisabled" />
                            <span asp-validation-for="Guest.Email" class="text-danger small" data-guest-email-error></span>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-5">
                            <label asp-for="Guest.IdentityNumber" class="form-label">Số giấy tờ @(requiredFull ? Html.Raw("<span class='text-danger'>*</span>") : Html.Raw(""))</label>
                            <input asp-for="Guest.IdentityNumber"
                                   class="form-control"
                                   maxlength="50"
                                   autocomplete="off"
                                   data-guest-identity-number
                                   required="@requiredFull"
                                   disabled="@guestDetailsDisabled" />
                            <span asp-validation-for="Guest.IdentityNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <label asp-for="Guest.IdentityType" class="form-label">Loại giấy tờ @(requiredFull ? Html.Raw("<span class='text-danger'>*</span>") : Html.Raw(""))</label>
                            <select asp-for="Guest.IdentityType"
                                    class="form-select"
                                    data-guest-identity-type
                                    required="@requiredFull"
                                    disabled="@guestDetailsDisabled">
                                <option value="">-- Chọn loại --</option>
                                <option value="0">CCCD</option>
                                <option value="1">Giấy phép lái xe</option>
                                <option value="2">Hộ chiếu</option>
                            </select>
                            <span asp-validation-for="Guest.IdentityType" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="small text-body-secondary h-100 d-flex align-items-end pb-1">
                                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                                @(requiredFull
                                    ? "Khi Booking đang ở, thông tin ngày sinh, giới tính, địa chỉ và giấy tờ là bắt buộc."
                                    : "Ở Chờ xác nhận/Chờ check in, các thông tin trên được phép để trống.")
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Guest.Note" class="form-label">Ghi chú khách hàng</label>
                            <textarea asp-for="Guest.Note"
                                      class="form-control booking-edit-textarea"
                                      rows="3"
                                      maxlength="255"
                                      placeholder="Nhập ghi chú cho khách hàng..."
                                      ></textarea>
                            <div class="d-flex justify-content-between gap-2 mt-1">
                                <span asp-validation-for="Guest.Note" class="text-danger small"></span>
                                <span class="small text-body-secondary text-nowrap">Tối đa 255 ký tự</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2 min-width-0">
                    <div class="booking-edit-section-icon" aria-hidden="true">
                        <i class="bi bi-door-open"></i>
                    </div>
                    <div class="min-width-0">
                        <h2 class="h6 mb-0 fw-semibold">Các BookingRoom đã đặt</h2>
                        <div class="small text-body-secondary">
                            Ghi chú phòng luôn có thể sửa. @(Model.CanEditServices ? "Dịch vụ và phí phát sinh cũng có thể thêm, sửa hoặc xóa." : "Dịch vụ và phí phát sinh không thuộc phạm vi chỉnh sửa của trạng thái hiện tại.")
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body">
                @if (Model.Rooms.Count == 0)
                {
                    <div class="booking-edit-empty-note">
                        <i class="bi bi-door-closed me-2" aria-hidden="true"></i>
                        Booking không có BookingRoom hợp lệ.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-4">
                        @for (var roomIndex = 0; roomIndex < Model.Rooms.Count; roomIndex++)
                        {
                            var room = Model.Rooms[roomIndex];
                            <article class="booking-edit-room-card rounded-3 border p-3 p-lg-4">
                                <input type="hidden" asp-for="Rooms[roomIndex].BookingRoomId" />

                                <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-start justify-content-between gap-3 mb-3">
                                    <div class="min-width-0">
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="badge text-bg-light border text-body font-monospace booking-edit-room-chip">@room.RoomTypeCode</span>
                                            <span class="fw-semibold booking-breakable">@room.RoomTypeName</span>
                                        </div>
                                        <div class="small text-body-secondary mt-1 booking-breakable">
                                            @if (string.IsNullOrWhiteSpace(room.RoomCode))
                                            {
                                                <span>Chưa gán phòng cụ thể</span>
                                            }
                                            else
                                            {
                                                <span class="font-monospace">@room.RoomCode</span>
                                                <span class="mx-1">·</span>
                                                <span>@room.RoomName</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="badge text-bg-secondary align-self-start">BookingRoom</span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Rooms[roomIndex].Note" class="form-label">Ghi chú phòng</label>
                                    <textarea asp-for="Rooms[roomIndex].Note"
                                              class="form-control booking-edit-textarea"
                                              rows="3"
                                              maxlength="255"
                                              placeholder="Ghi chú riêng cho BookingRoom..."></textarea>
                                    <div class="d-flex justify-content-between gap-2 mt-1">
                                        <span asp-validation-for="Rooms[roomIndex].Note" class="text-danger small"></span>
                                        <span class="small text-body-secondary text-nowrap">Tối đa 255 ký tự</span>
                                    </div>
                                </div>

                                @if (Model.CanEditServices)
                                {
                                    <div class="row g-4">
                                        <div class="col-12 col-xl-7">
                                            <div class="d-flex align-items-start align-items-sm-center justify-content-between gap-2 mb-2">
                                                <div>
                                                    <h3 class="h6 mb-1 fw-semibold">Dịch vụ</h3>
                                                    <div class="small text-body-secondary">Có thể thêm, sửa hoặc xóa từng dòng dịch vụ.</div>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary text-nowrap"
                                                        data-add-service="@roomIndex">
                                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                                    Thêm dịch vụ
                                                </button>
                                            </div>

                                            <div class="d-flex flex-column gap-2" data-service-list="@roomIndex">
                                                @for (var serviceIndex = 0; serviceIndex < room.ServiceInputs.Count; serviceIndex++)
                                                {
                                                    var serviceRow = room.ServiceInputs[serviceIndex];
                                                    var existing = serviceRow.Id.HasValue && serviceRow.Id.Value != Guid.Empty;
                                                    <div class="booking-edit-line rounded-3 border p-3 @(serviceRow.IsDeleted ? "d-none" : "")"
                                                         data-edit-row="service"
                                                         data-existing="@existing.ToString().ToLowerInvariant()">
                                                        <input type="hidden" asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].Id" />
                                                        <input type="hidden" asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].IsDeleted" data-deleted-input />

                                                        <div class="row g-3">
                                                            <div class="col-12 col-lg-7">
                                                                <label asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].ServiceId" class="form-label">Dịch vụ</label>
                                                                <select asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].ServiceId" class="form-select">
                                                                    <option value="">-- Chọn dịch vụ --</option>
                                                                    @foreach (var option in Model.Services)
                                                                    {
                                                                        <option value="@option.Id">
                                                                            @option.ServiceCode · @option.ServiceName@(option.IsActive ? "" : " · Ngừng kinh doanh")
                                                                        </option>
                                                                    }
                                                                </select>
                                                                <span asp-validation-for="Rooms[roomIndex].ServiceInputs[serviceIndex].ServiceId" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-lg-5">
                                                                <label asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].UsedAt" class="form-label">Thời gian sử dụng</label>
                                                                <input asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].UsedAt"
                                                                       type="datetime-local"
                                                                       class="form-control" />
                                                                <span asp-validation-for="Rooms[roomIndex].ServiceInputs[serviceIndex].UsedAt" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-sm-6">
                                                                <label asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].TotalPrice" class="form-label">Thành tiền</label>
                                                                <div class="input-group">
                                                                    <input asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].TotalPrice"
                                                                           class="form-control text-end"
                                                                           min="0"
                                                                           step="1000"
                                                                           inputmode="decimal" />
                                                                    <span class="input-group-text">₫</span>
                                                                </div>
                                                                <span asp-validation-for="Rooms[roomIndex].ServiceInputs[serviceIndex].TotalPrice" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-sm-6 d-flex align-items-end justify-content-sm-end">
                                                                <button type="button"
                                                                        class="btn btn-outline-danger"
                                                                        data-delete-row
                                                                        title="Xóa dịch vụ này"
                                                                        aria-label="Xóa dịch vụ này">
                                                                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>
                                                                    Xóa dòng
                                                                </button>
                                                            </div>
                                                            <div class="col-12">
                                                                <label asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].Note" class="form-label">Ghi chú dịch vụ</label>
                                                                <textarea asp-for="Rooms[roomIndex].ServiceInputs[serviceIndex].Note"
                                                                          class="form-control"
                                                                          rows="2"
                                                                          maxlength="255"
                                                                          placeholder="Ghi chú cho lần sử dụng dịch vụ..."></textarea>
                                                                <div class="d-flex justify-content-between gap-2 mt-1">
                                                                    <span asp-validation-for="Rooms[roomIndex].ServiceInputs[serviceIndex].Note" class="text-danger small"></span>
                                                                    <span class="small text-body-secondary text-nowrap">Tối đa 255 ký tự</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="small text-body-secondary mt-2 @(room.ServiceInputs.Any(x => !x.IsDeleted) ? "d-none" : "")" data-service-empty="@roomIndex">
                                                Chưa có dịch vụ nào.
                                            </div>

                                            <template data-service-template="@roomIndex">
                                                <div class="booking-edit-line rounded-3 border p-3" data-edit-row="service" data-existing="false">
                                                    <input type="hidden" name="Rooms[@roomIndex].ServiceInputs[__INDEX__].Id" value="" />
                                                    <input type="hidden" name="Rooms[@roomIndex].ServiceInputs[__INDEX__].IsDeleted" value="false" data-deleted-input />
                                                    <div class="row g-3">
                                                        <div class="col-12 col-lg-7">
                                                            <label class="form-label">Dịch vụ</label>
                                                            <select name="Rooms[@roomIndex].ServiceInputs[__INDEX__].ServiceId" class="form-select">
                                                                <option value="">-- Chọn dịch vụ --</option>
                                                                @foreach (var option in Model.Services)
                                                                {
                                                                    <option value="@option.Id">
                                                                        @option.ServiceCode · @option.ServiceName@(option.IsActive ? "" : " · Ngừng kinh doanh")
