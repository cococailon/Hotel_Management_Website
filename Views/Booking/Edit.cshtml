                                                </div>
                                            </template>
                                        </div>

                                        <div class="col-12 col-xl-5">
                                            <div class="d-flex align-items-start align-items-sm-center justify-content-between gap-2 mb-2">
                                                <div>
                                                    <h3 class="h6 mb-1 fw-semibold">Phí phát sinh</h3>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary text-nowrap"
                                                        data-add-fee="@roomIndex">
                                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                                    Thêm phí
                                                </button>
                                            </div>

                                            <div class="d-flex flex-column gap-2" data-fee-list="@roomIndex">
                                                @for (var feeIndex = 0; feeIndex < room.FeeInputs.Count; feeIndex++)
                                                {
                                                    var feeRow = room.FeeInputs[feeIndex];
                                                    var existing = feeRow.Id.HasValue && feeRow.Id.Value != Guid.Empty;
                                                    <div class="booking-edit-line rounded-3 border p-3 @(feeRow.IsDeleted ? "d-none" : "")"
                                                         data-edit-row="fee"
                                                         data-existing="@existing.ToString().ToLowerInvariant()">
                                                        <input type="hidden" asp-for="Rooms[roomIndex].FeeInputs[feeIndex].Id" />
                                                        <input type="hidden" asp-for="Rooms[roomIndex].FeeInputs[feeIndex].IsDeleted" data-deleted-input />

                                                        <div class="row g-3">
                                                            <div class="col-12 col-sm-7">
                                                                <label asp-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeName" class="form-label">Tên phí</label>
                                                                <input asp-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeName" class="form-control" maxlength="100" />
                                                                <span asp-validation-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeName" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-sm-5">
                                                                <label asp-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeType" class="form-label">Loại phí</label>
                                                                <select asp-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeType" class="form-select">
                                                                    <option value="0">Phí mua đồ hộ</option>
                                                                    <option value="1">Phí hỏng hóc/mất mát</option>
                                                                    <option value="2">Khác</option>
                                                                </select>
                                                                <span asp-validation-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeType" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-sm-7">
                                                                <label asp-for="Rooms[roomIndex].FeeInputs[feeIndex].TotalFee" class="form-label">Thành tiền</label>
                                                                <div class="input-group">
                                                                    <input asp-for="Rooms[roomIndex].FeeInputs[feeIndex].TotalFee"
                                                                           class="form-control text-end"
                                                                           min="0.01"
                                                                           step="0.01"
                                                                           inputmode="decimal" />
                                                                    <span class="input-group-text">₫</span>
                                                                </div>
                                                                <span asp-validation-for="Rooms[roomIndex].FeeInputs[feeIndex].TotalFee" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-sm-5 d-flex align-items-end justify-content-sm-end">
                                                                <button type="button"
                                                                        class="btn btn-outline-danger"
                                                                        data-delete-row
                                                                        title="Xóa phí này"
                                                                        aria-label="Xóa phí này">
                                                                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>
                                                                    Xóa dòng
                                                                </button>
                                                            </div>
                                                            <div class="col-12">
                                                                <label asp-for="Rooms[roomIndex].FeeInputs[feeIndex].Description" class="form-label">Mô tả</label>
                                                                <textarea asp-for="Rooms[roomIndex].FeeInputs[feeIndex].Description"
                                                                          class="form-control"
                                                                          rows="2"
                                                                          maxlength="255"
                                                                          placeholder="Mô tả chi tiết phí phát sinh..."></textarea>
                                                                <div class="d-flex justify-content-between gap-2 mt-1">
                                                                    <span asp-validation-for="Rooms[roomIndex].FeeInputs[feeIndex].Description" class="text-danger small"></span>
                                                                    <span class="small text-body-secondary text-nowrap">Tối đa 255 ký tự</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="small text-body-secondary mt-2 @(room.FeeInputs.Any(x => !x.IsDeleted) ? "d-none" : "")" data-fee-empty="@roomIndex">
                                                Chưa có phí phát sinh nào.
                                            </div>

                                            <template data-fee-template="@roomIndex">
                                                <div class="booking-edit-line rounded-3 border p-3" data-edit-row="fee" data-existing="false">
                                                    <input type="hidden" name="Rooms[@roomIndex].FeeInputs[__INDEX__].Id" value="" />
                                                    <input type="hidden" name="Rooms[@roomIndex].FeeInputs[__INDEX__].IsDeleted" value="false" data-deleted-input />
                                                    <div class="row g-3">
                                                        <div class="col-12 col-sm-7">
                                                            <label class="form-label">Tên phí</label>
                                                            <input type="text" name="Rooms[@roomIndex].FeeInputs[__INDEX__].FeeName" class="form-control" maxlength="100" />
                                                        </div>
                                                        <div class="col-12 col-sm-5">
                                                            <label class="form-label">Loại phí</label>
                                                            <select name="Rooms[@roomIndex].FeeInputs[__INDEX__].FeeType" class="form-select">
                                                                <option value="0">Phí mua đồ hộ</option>
                                                                <option value="1">Phí hỏng hóc/mất mát</option>
                                                                <option value="2">Khác</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-12 col-sm-7">
                                                            <label class="form-label">Thành tiền</label>
                                                            <div class="input-group">
                                                                <input type="number" name="Rooms[@roomIndex].FeeInputs[__INDEX__].TotalFee" class="form-control text-end" min="0.01" step="0.01" value="0" inputmode="decimal" />
                                                                <span class="input-group-text">₫</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-12 col-sm-5 d-flex align-items-end justify-content-sm-end">
                                                            <button type="button" class="btn btn-outline-danger" data-delete-row>
                                                                <i class="bi bi-trash3 me-1" aria-hidden="true"></i>
                                                                Xóa dòng
                                                            </button>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label">Mô tả</label>
                                                            <textarea name="Rooms[@roomIndex].FeeInputs[__INDEX__].Description"
                                                                      class="form-control"
                                                                      rows="2"
                                                                      maxlength="255"
                                                                      placeholder="Mô tả chi tiết phí phát sinh..."></textarea>
                                                            <div class="small text-body-secondary mt-1">Tối đa 255 ký tự</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-light border mb-0 small">
                                        <i class="bi bi-lock me-1" aria-hidden="true"></i>
                                        Dịch vụ và phí phát sinh không được thêm, sửa hoặc xóa khi Booking ở trạng thái <strong>@Model.StatusName</strong>.
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </div>
        </section>

        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pb-4">
            <a asp-controller="Booking" asp-action="Index" class="btn btn-outline-secondary">
                Hủy thay đổi
            </a>
            <button type="submit" class="btn btn-primary" id="bookingEditSubmitButton" data-ui-submit>
                <span class="ui-button-content">
                    <i class="bi bi-save2 me-1" aria-hidden="true"></i>
                    Lưu thay đổi
                </span>
                <span class="ui-button-loading d-none">
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    Đang lưu...
                </span>
            </button>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />

    <script>
        (() => {
            "use strict";

            const form = document.getElementById("bookingEditForm");
            if (!form) {
                return;
            }

            let confirmed = false;

            const updateEmptyState = (kind, roomIndex) => {
                const list = form.querySelector(`[data-${kind}-list="${roomIndex}"]`);
                const empty = form.querySelector(`[data-${kind}-empty="${roomIndex}"]`);
                if (!list || !empty) {
                    return;
                }

                const visibleRows = list.querySelectorAll(`[data-edit-row="${kind}"]:not(.d-none)`);
                empty.classList.toggle("d-none", visibleRows.length !== 0);
            };

            const addRow = (kind, roomIndex) => {
                const list = form.querySelector(`[data-${kind}-list="${roomIndex}"]`);
                const template = form.querySelector(`[data-${kind}-template="${roomIndex}"]`);
                if (!list || !template) {
                    return;
                }

                const nextIndexKey = `next${kind.charAt(0).toUpperCase()}${kind.slice(1)}Index`;
                const nextIndex = Number.parseInt(list.dataset[nextIndexKey] ?? "0", 10);
                list.dataset[nextIndexKey] = String(nextIndex + 1);

                const wrapper = document.createElement("div");
                wrapper.innerHTML = template.innerHTML.replaceAll("__INDEX__", String(nextIndex));
                const row = wrapper.firstElementChild;
                if (!row) {
                    return;
                }

                list.appendChild(row);
                updateEmptyState(kind, roomIndex);
            };

            form.querySelectorAll("[data-service-list]").forEach((list) => {
                const roomIndex = list.getAttribute("data-service-list");
                list.dataset.nextServiceIndex = String(list.querySelectorAll('[data-edit-row="service"]').length);
                updateEmptyState("service", roomIndex);
            });

            form.querySelectorAll("[data-fee-list]").forEach((list) => {
                const roomIndex = list.getAttribute("data-fee-list");
                list.dataset.nextFeeIndex = String(list.querySelectorAll('[data-edit-row="fee"]').length);
                updateEmptyState("fee", roomIndex);
            });

            form.addEventListener("click", (event) => {
                const addServiceButton = event.target.closest("[data-add-service]");
                if (addServiceButton) {
                    addRow("service", addServiceButton.getAttribute("data-add-service"));
                    return;
                }

                const addFeeButton = event.target.closest("[data-add-fee]");
                if (addFeeButton) {
                    addRow("fee", addFeeButton.getAttribute("data-add-fee"));
                    return;
                }

                const deleteButton = event.target.closest("[data-delete-row]");
                if (!deleteButton) {
                    return;
                }

                const row = deleteButton.closest("[data-edit-row]");
                if (!row) {
                    return;
                }

                const roomIndex = row.closest("[data-service-list], [data-fee-list]")?.getAttribute("data-service-list")
                    ?? row.closest("[data-fee-list]")?.getAttribute("data-fee-list");
                const kind = row.getAttribute("data-edit-row");
                const existing = row.dataset.existing === "true";

                // Không remove row khỏi DOM vì ASP.NET Core model binder yêu cầu
                // index của collection liên tục. Cả row cũ và row mới đều được
                // đánh dấu IsDeleted rồi ẩn đi; server sẽ bỏ qua row mới bị hủy.
                const deletedInput = row.querySelector("[data-deleted-input]");
                if (deletedInput) {
                    deletedInput.value = "true";
                }
                row.classList.add("d-none");

                if (!existing) {
                    row.dataset.deletedClientSide = "true";
                }

                if (kind && roomIndex !== null) {
                    updateEmptyState(kind, roomIndex);
                }
            });

            const guestCode = form.querySelector("[data-guest-code]");
            const guestName = form.querySelector("[data-guest-name]");
            const guestDob = form.querySelector("[data-guest-dob]");
            const guestSex = form.querySelector("[data-guest-sex]");
            const guestAddress = form.querySelector("[data-guest-address]");
            const guestPhone = form.querySelector("[data-guest-phone]");
            const guestEmail = form.querySelector("[data-guest-email]");
            const guestIdentityNumber = form.querySelector("[data-guest-identity-number]");
            const guestIdentityType = form.querySelector("[data-guest-identity-type]");
            const guestNote = form.querySelector("[data-guest-note]");
            const guestDetailsEditable = form.querySelector('[name="Guest.GuestCode"]:not(:disabled)') !== null;
            const requireFullGuestDetails = @Model.RequireFullGuestDetails.ToString().ToLowerInvariant();

            const getMessageElement = (input) => {
                if (!input?.name) return null;
                return form.querySelector(`[data-valmsg-for="${CSS.escape(input.name)}"]`);
            };

            const setFieldError = (input, message) => {
                if (!input) return;
                input.classList.add("is-invalid");
                input.setAttribute("aria-invalid", "true");
                const messageElement = getMessageElement(input);
                if (messageElement) {
                    messageElement.textContent = message;
                    messageElement.classList.remove("field-validation-valid");
                    messageElement.classList.add("field-validation-error");
                }
            };

            const clearFieldError = (input) => {
                if (!input) return;
                input.classList.remove("is-invalid");
                input.removeAttribute("aria-invalid");
                const messageElement = getMessageElement(input);
                if (messageElement) {
                    messageElement.textContent = "";
                    messageElement.classList.remove("field-validation-error");
                    messageElement.classList.add("field-validation-valid");
                }
            };

            const validateCode = (input, label) => {
                if (!guestDetailsEditable) return true;
                const value = input?.value.trim() ?? "";
                if (!value) {
                    setFieldError(input, `${label} không được để trống.`);
                    return false;
                }
                if (!/^[A-Za-z0-9]+$/.test(value)) {
                    setFieldError(input, `${label} chỉ được bao gồm chữ hoa, chữ thường và số, không chứa dấu cách và ký tự đặc biệt.`);
                    return false;
                }
                if (value.length > 50) {
                    setFieldError(input, `${label} không được vượt quá 50 ký tự.`);
                    return false;
                }
                clearFieldError(input);
                return true;
            };

            const validateName = () => {
                if (!guestDetailsEditable) return true;
                const value = guestName?.value.trim() ?? "";
                if (!value) {
                    setFieldError(guestName, "Tên khách hàng không được để trống.");
                    return false;
                }
                if (value.length > 100) {
                    setFieldError(guestName, "Tên khách hàng không được vượt quá 100 ký tự.");
                    return false;
                }
                clearFieldError(guestName);
                return true;
            };

            const validateDob = () => {
                if (!guestDetailsEditable) return true;
                const value = guestDob?.value ?? "";
                if (!value) {
                    if (requireFullGuestDetails) {
                        setFieldError(guestDob, "Ngày sinh là bắt buộc khi Booking đang ở trạng thái Đang ở.");
                        return false;
                    }
                    clearFieldError(guestDob);
                    return true;
                }
                const date = new Date(`${value}T00:00:00`);
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                if (Number.isNaN(date.getTime()) || date > today) {
                    setFieldError(guestDob, "Ngày sinh không được lớn hơn ngày hiện tại.");
                    return false;
                }
                clearFieldError(guestDob);
                return true;
            };

            const validateSex = () => {
                if (!guestDetailsEditable) return true;
                const value = guestSex?.value ?? "";
                if (!value) {
                    if (requireFullGuestDetails) {
                        setFieldError(guestSex, "Giới tính là bắt buộc khi Booking đang ở trạng thái Đang ở.");
                        return false;
                    }
                    clearFieldError(guestSex);
                    return true;
                }
                if (!["0", "1", "2"].includes(value)) {
                    setFieldError(guestSex, "Giới tính khách hàng không hợp lệ.");
                    return false;
                }
                clearFieldError(guestSex);
                return true;
            };

            const validateAddress = () => {
                if (!guestDetailsEditable) return true;
                const value = guestAddress?.value.trim() ?? "";
                if (!value && requireFullGuestDetails) {
                    setFieldError(guestAddress, "Địa chỉ là bắt buộc khi Booking đang ở trạng thái Đang ở.");
                    return false;
                }
                if (value.length > 255) {
                    setFieldError(guestAddress, "Địa chỉ không được vượt quá 255 ký tự.");
                    return false;
                }
                clearFieldError(guestAddress);
                return true;
            };

            const normalizePhone = (raw) => {
                let value = String(raw ?? "").trim().replace(/[\s().-]/g, "");
                if (value.startsWith("00")) value = "+" + value.slice(2);
                return value;
            };

                    const validatePhone = () => {
            if (!guestDetailsEditable) return true;

            const value = guestPhone?.value.trim() ?? "";
            const emailValue = guestEmail?.value.trim() ?? "";

            // Booking đang ở: SĐT bắt buộc, Email không bắt buộc.
            if (requireFullGuestDetails && !value) {
                setFieldError(
                    guestPhone,
                    "Số điện thoại là bắt buộc khi Booking đang ở trạng thái Đang ở."
                );
                return false;
            }

            // Booking Chờ xác nhận / Chờ check in:
            // phải có ít nhất SĐT hoặc Email.
            if (!requireFullGuestDetails && !value && !emailValue) {
                setFieldError(
                    guestPhone,
                    "Khách hàng phải có ít nhất số điện thoại hoặc email."
                );

                if (guestEmail) {
                    setFieldError(
                        guestEmail,
                        "Khách hàng phải có ít nhất số điện thoại hoặc email."
                    );
                }

                return false;
            }

            // Nếu không có SĐT ở trường hợp không bắt buộc thì không validate format.
            if (!value) {
                clearFieldError(guestPhone);
                return true;
            }

            if (value.length > 30) {
                setFieldError(
                    guestPhone,
                    "Số điện thoại nhập vào không được vượt quá 30 ký tự."
                );
                return false;
            }

            const normalized = normalizePhone(value);

            const valid = normalized.startsWith("+")
                ? /^\+[1-9][0-9]{6,14}$/.test(normalized)
                : /^[0-9]{7,15}$/.test(normalized);

            if (!valid) {
                setFieldError(
                    guestPhone,
                    "Số điện thoại không hợp lệ. Có thể nhập số quốc tế; sau khi chuẩn hóa phải có 7-15 chữ số."
                );
                return false;
            }

            clearFieldError(guestPhone);
            return true;
        };

                    const validateEmail = () => {
            if (!guestDetailsEditable) return true;

            const value = guestEmail?.value.trim() ?? "";

            // Email luôn không bắt buộc.
            // Với Status 0/1, validatePhone() đã chịu trách nhiệm
            // kiểm tra điều kiện "ít nhất SĐT hoặc Email".
            if (!value) {
                clearFieldError(guestEmail);
                return true;
            }

            if (
                value.length > 254 ||
                !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value)
            ) {
                setFieldError(
                    guestEmail,
                    "Email không đúng định dạng hoặc vượt quá 254 ký tự."
                );
                return false;
            }

            clearFieldError(guestEmail);
            return true;
        };

            const validateIdentity = () => {
                if (!guestDetailsEditable) return true;
                const number = guestIdentityNumber?.value.trim() ?? "";
                const type = guestIdentityType?.value ?? "";

                if (!number) {
                    if (requireFullGuestDetails) {
                        setFieldError(guestIdentityNumber, "Số giấy tờ là bắt buộc khi Booking đang ở trạng thái Đang ở.");
                        return false;
                    }
                    clearFieldError(guestIdentityNumber);
                    if (!type) clearFieldError(guestIdentityType);
                    return true;
                }

                if (number.length > 50) {
                    setFieldError(guestIdentityNumber, "Số giấy tờ không được vượt quá 50 ký tự.");
                    return false;
                }

                if (!["0", "1", "2"].includes(type)) {
                    setFieldError(guestIdentityType, "Vui lòng chọn loại giấy tờ khi nhập số giấy tờ.");
                    return false;
                }

                if (type === "0" && !/^\d{12}$/.test(number)) {
                    setFieldError(guestIdentityNumber, "CCCD phải gồm đúng 12 chữ số.");
                    return false;
                }
                if (type === "1" && !/^\d{12}$/.test(number)) {
                    setFieldError(guestIdentityNumber, "Giấy phép lái xe phải gồm đúng 12 chữ số.");
                    return false;
                }
                if (type === "2" && !/^[A-Za-z0-9]{5,20}$/.test(number)) {
                    setFieldError(guestIdentityNumber, "Hộ chiếu phải gồm 5-20 ký tự chữ và số, không chứa dấu cách hoặc ký tự đặc biệt.");
                    return false;
                }

                clearFieldError(guestIdentityNumber);
                clearFieldError(guestIdentityType);
                return true;
            };

            const validateNote = () => {
                if (!guestDetailsEditable) return true;
                const value = guestNote?.value.trim() ?? "";
                if (value.length > 255) {
                    setFieldError(guestNote, "Ghi chú khách hàng không được vượt quá 255 ký tự.");
                    return false;
                }
                clearFieldError(guestNote);
                return true;
            };

            if (guestDetailsEditable) {
                guestCode?.addEventListener("input", () => validateCode(guestCode, "Mã khách hàng"));
                guestName?.addEventListener("input", validateName);
                guestDob?.addEventListener("input", validateDob);
                guestSex?.addEventListener("change", validateSex);
                guestAddress?.addEventListener("input", validateAddress);
                guestPhone?.addEventListener("input", validatePhone);
                guestEmail?.addEventListener("input", validateEmail);
                guestIdentityNumber?.addEventListener("input", validateIdentity);
                guestIdentityType?.addEventListener("change", validateIdentity);
                guestNote?.addEventListener("input", validateNote);
            }

            form.addEventListener("submit", (event) => {
                if (confirmed) {
                    return;
                }

                event.preventDefault();

                if (guestDetailsEditable) {
                    const checks = [
                        () => validateCode(guestCode, "Mã khách hàng"),
                        validateName,
                        validateDob,
                        validateSex,
                        validateAddress,
                        validatePhone,
                        validateEmail,
                        validateIdentity,
                        validateNote
                    ];

                    let firstInvalid = null;
                    let hasGuestError = false;

                    for (const check of checks) {
                        if (!check()) {
                            hasGuestError = true;
                            if (!firstInvalid) {
                                firstInvalid = form.querySelector(".is-invalid");
                            }
                        }
                    }

                    const invalids = Array.from(form.querySelectorAll(".is-invalid"));
                    if (invalids.length > 0) {
                        firstInvalid = invalids[0];
                    }

                    if (hasGuestError || invalids.length > 0) {
                        firstInvalid?.focus();
                        firstInvalid?.scrollIntoView({ behavior: "smooth", block: "center" });
                        return;
                    }
                }

                if (!form.checkValidity()) {
                    form.classList.add("was-validated");
                    const firstInvalid = form.querySelector(":invalid");
                    firstInvalid?.focus();
                    firstInvalid?.scrollIntoView({ behavior: "smooth", block: "center" });
                    return;
                }

                const submit = () => {
                    confirmed = true;
                    const button = document.getElementById("bookingEditSubmitButton");
                    if (button && window.HotelUI?.setButtonLoading) {
                        window.HotelUI.setButtonLoading(button, true, "Đang lưu...");
                    }
                    form.submit();
                };

                if (typeof window.HotelUI?.showConfirm === "function") {
                    window.HotelUI.showConfirm({
                        title: "Xác nhận lưu thay đổi",
                        message: `Bạn có chắc chắn muốn lưu thay đổi cho Booking ${@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookingCode))}?`,
                        note: "Hệ thống sẽ kiểm tra lại trạng thái Booking, sức chứa và tính hợp lệ của dịch vụ/phí phát sinh ngay trước khi lưu.",
                        variant: "primary",
                        confirmText: "Lưu thay đổi",
                        onConfirm: submit
                    });
                } else {
                    submit();
                }
            });
        })();
    </script>
}
