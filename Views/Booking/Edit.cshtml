                                                        </div>
                                                        <div class="col-12 col-sm-6">
                                                            <label class="form-label">Thành tiền</label>
                                                            <div class="input-group">
                                                                <input type="number"
                                                                       name="Rooms[@roomIndex].ServiceInputs[__INDEX__].TotalPrice"
                                                                       class="form-control text-end"
                                                                       min="0"
                                                                       step="0.01"
                                                                       value="0"
                                                                       inputmode="decimal" />
                                                                <span class="input-group-text">₫</span>
