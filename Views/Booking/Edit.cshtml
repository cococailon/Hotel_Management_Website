                                                            </button>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label">Ghi chú dịch vụ</label>
                                                            <textarea name="Rooms[@roomIndex].ServiceInputs[__INDEX__].Note"
                                                                      class="form-control"
                                                                      rows="2"
                                                                      maxlength="255"
                                                                      placeholder="Ghi chú cho lần sử dụng dịch vụ..."></textarea>
                                                            <div class="small text-body-secondary mt-1">Tối đa 255 ký tự</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </template>
                                        </div>

                                        <div class="col-12 col-xl-5">
                                            <div class="d-flex align-items-start align-items-sm-center justify-content-between gap-2 mb-2">
                                                <div>
                                                    <h3 class="h6 mb-1 fw-semibold">Phí phát sinh</h3>
                                                    <div class="small text-body-secondary">Có thể thêm, sửa hoặc xóa phí phát sinh của BookingRoom.</div>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary text-nowrap"
                                                        data-add-fee="@roomIndex">
                                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                                    Thêm phí
                                                </button>
                                            </div>

                                            <div class="d-flex flex-column gap-2" data-fee-list="@roomIndex">
                                                @for (var feeIndex = 0; feeIndex < room.FeeInputs.Count; feeIndex++)
                                                {
                                                    var feeRow = room.FeeInputs[feeIndex];
                                                    var existing = feeRow.Id.HasValue && feeRow.Id.Value != Guid.Empty;
                                                    <div class="booking-edit-line rounded-3 border p-3 @(feeRow.IsDeleted ? "d-none" : "")"
                                                         data-edit-row="fee"
                                                         data-existing="@existing.ToString().ToLowerInvariant()">
                                                        <input type="hidden" asp-for="Rooms[roomIndex].FeeInputs[feeIndex].Id" />
                                                        <input type="hidden" asp-for="Rooms[roomIndex].FeeInputs[feeIndex].IsDeleted" data-deleted-input />

                                                        <div class="row g-3">
                                                            <div class="col-12 col-sm-7">
                                                                <label asp-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeName" class="form-label">Tên phí</label>
                                                                <input asp-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeName" class="form-control" maxlength="100" />
                                                                <span asp-validation-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeName" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-sm-5">
                                                                <label asp-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeType" class="form-label">Loại phí</label>
                                                                <select asp-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeType" class="form-select">
                                                                    <option value="0">Phí mua đồ hộ</option>
                                                                    <option value="1">Phí hỏng hóc/mất mát</option>
                                                                    <option value="2">Khác</option>
                                                                </select>
                                                                <span asp-validation-for="Rooms[roomIndex].FeeInputs[feeIndex].FeeType" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-sm-7">
                                                                <label asp-for="Rooms[roomIndex].FeeInputs[feeIndex].TotalFee" class="form-label">Thành tiền</label>
                                                                <div class="input-group">
                                                                    <input asp-for="Rooms[roomIndex].FeeInputs[feeIndex].TotalFee"
                                                                           class="form-control text-end"
                                                                           min="0.01"
                                                                           step="1000"
                                                                           inputmode="decimal" />
                                                                    <span class="input-group-text">₫</span>
                                                                </div>
                                                                <span asp-validation-for="Rooms[roomIndex].FeeInputs[feeIndex].TotalFee" class="text-danger small"></span>
                                                            </div>
                                                            <div class="col-12 col-sm-5 d-flex align-items-end justify-content-sm-end">
                                                                <button type="button"
                                                                        class="btn btn-outline-danger"
                                                                        data-delete-row
                                                                        title="Xóa phí này"
                                                                        aria-label="Xóa phí này">
                                                                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>
                                                                    Xóa dòng
                                                                </button>
                                                            </div>
                                                            <div class="col-12">
                                                                <label asp-for="Rooms[roomIndex].FeeInputs[feeIndex].Description" class="form-label">Mô tả</label>
                                                                <textarea asp-for="Rooms[roomIndex].FeeInputs[feeIndex].Description"
                                                                          class="form-control"
                                                                          rows="2"
                                                                          maxlength="255"
                                                                          placeholder="Mô tả chi tiết phí phát sinh..."></textarea>
                                                                <div class="d-flex justify-content-between gap-2 mt-1">
                                                                    <span asp-validation-for="Rooms[roomIndex].FeeInputs[feeIndex].Description" class="text-danger small"></span>
                                                                    <span class="small text-body-secondary text-nowrap">Tối đa 255 ký tự</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <div class="small text-body-secondary mt-2 @(room.FeeInputs.Any(x => !x.IsDeleted) ? "d-none" : "")" data-fee-empty="@roomIndex">
                                                Chưa có phí phát sinh nào.
                                            </div>

                                            <template data-fee-template="@roomIndex">
                                                <div class="booking-edit-line rounded-3 border p-3" data-edit-row="fee" data-existing="false">
                                                    <input type="hidden" name="Rooms[@roomIndex].FeeInputs[__INDEX__].Id" value="" />
                                                    <input type="hidden" name="Rooms[@roomIndex].FeeInputs[__INDEX__].IsDeleted" value="false" data-deleted-input />
                                                    <div class="row g-3">
                                                        <div class="col-12 col-sm-7">
                                                            <label class="form-label">Tên phí</label>
                                                            <input type="text" name="Rooms[@roomIndex].FeeInputs[__INDEX__].FeeName" class="form-control" maxlength="100" />
                                                        </div>
                                                        <div class="col-12 col-sm-5">
                                                            <label class="form-label">Loại phí</label>
                                                            <select name="Rooms[@roomIndex].FeeInputs[__INDEX__].FeeType" class="form-select">
                                                                <option value="0">Phí mua đồ hộ</option>
                                                                <option value="1">Phí hỏng hóc/mất mát</option>
                                                                <option value="2">Khác</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-12 col-sm-7">
                                                            <label class="form-label">Thành tiền</label>
                                                            <div class="input-group">
                                                                <input type="number" name="Rooms[@roomIndex].FeeInputs[__INDEX__].TotalFee" class="form-control text-end" min="0.01" step="1000" value="0" inputmode="decimal" />
                                                                <span class="input-group-text">₫</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-12 col-sm-5 d-flex align-items-end justify-content-sm-end">
                                                            <button type="button" class="btn btn-outline-danger" data-delete-row>
                                                                <i class="bi bi-trash3 me-1" aria-hidden="true"></i>
                                                                Xóa dòng
                                                            </button>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label">Mô tả</label>
                                                            <textarea name="Rooms[@roomIndex].FeeInputs[__INDEX__].Description"
                                                                      class="form-control"
                                                                      rows="2"
                                                                      maxlength="255"
                                                                      placeholder="Mô tả chi tiết phí phát sinh..."></textarea>
                                                            <div class="small text-body-secondary mt-1">Tối đa 255 ký tự</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </template>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-light border mb-0 small">
                                        <i class="bi bi-lock me-1" aria-hidden="true"></i>
                                        Dịch vụ và phí phát sinh không được thêm, sửa hoặc xóa khi Booking ở trạng thái <strong>@Model.StatusName</strong>.
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </div>
        </section>

        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pb-4">
            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary">
                Hủy thay đổi
            </a>
            <button type="submit" class="btn btn-primary" id="bookingEditSubmitButton" data-ui-submit>
                <span class="ui-button-content">
                    <i class="bi bi-save2 me-1" aria-hidden="true"></i>
                    Lưu thay đổi
                </span>
                <span class="ui-button-loading d-none">
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    Đang lưu...
                </span>
            </button>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />

    <script>
        (() => {
            "use strict";

            const form = document.getElementById("bookingEditForm");
            if (!form) {
                return;
            }

            let confirmed = false;

            const updateEmptyState = (kind, roomIndex) => {
                const list = form.querySelector(`[data-${kind}-list="${roomIndex}"]`);
                const empty = form.querySelector(`[data-${kind}-empty="${roomIndex}"]`);
                if (!list || !empty) {
                    return;
                }

                const visibleRows = list.querySelectorAll(`[data-edit-row="${kind}"]:not(.d-none)`);
                empty.classList.toggle("d-none", visibleRows.length !== 0);
            };

            const addRow = (kind, roomIndex) => {
                const list = form.querySelector(`[data-${kind}-list="${roomIndex}"]`);
                const template = form.querySelector(`[data-${kind}-template="${roomIndex}"]`);
                if (!list || !template) {
                    return;
                }

                const nextIndexKey = `next${kind.charAt(0).toUpperCase()}${kind.slice(1)}Index`;
                const nextIndex = Number.parseInt(list.dataset[nextIndexKey] ?? "0", 10);
                list.dataset[nextIndexKey] = String(nextIndex + 1);

                const wrapper = document.createElement("div");
                wrapper.innerHTML = template.innerHTML.replaceAll("__INDEX__", String(nextIndex));
                const row = wrapper.firstElementChild;
                if (!row) {
                    return;
                }

                list.appendChild(row);
                updateEmptyState(kind, roomIndex);
            };

            form.querySelectorAll("[data-service-list]").forEach((list) => {
                const roomIndex = list.getAttribute("data-service-list");
                list.dataset.nextServiceIndex = String(list.querySelectorAll('[data-edit-row="service"]').length);
                updateEmptyState("service", roomIndex);
            });

            form.querySelectorAll("[data-fee-list]").forEach((list) => {
                const roomIndex = list.getAttribute("data-fee-list");
                list.dataset.nextFeeIndex = String(list.querySelectorAll('[data-edit-row="fee"]').length);
                updateEmptyState("fee", roomIndex);
            });

            form.addEventListener("click", (event) => {
                const addServiceButton = event.target.closest("[data-add-service]");
                if (addServiceButton) {
                    addRow("service", addServiceButton.getAttribute("data-add-service"));
                    return;
                }

                const addFeeButton = event.target.closest("[data-add-fee]");
                if (addFeeButton) {
                    addRow("fee", addFeeButton.getAttribute("data-add-fee"));
                    return;
                }

                const deleteButton = event.target.closest("[data-delete-row]");
                if (!deleteButton) {
                    return;
                }

                const row = deleteButton.closest("[data-edit-row]");
                if (!row) {
                    return;
                }

                const roomIndex = row.closest("[data-service-list], [data-fee-list]")?.getAttribute("data-service-list")
                    ?? row.closest("[data-fee-list]")?.getAttribute("data-fee-list");
                const kind = row.getAttribute("data-edit-row");
                const existing = row.dataset.existing === "true";

                // Không remove row khỏi DOM vì ASP.NET Core model binder yêu cầu
                // index của collection liên tục. Cả row cũ và row mới đều được
                // đánh dấu IsDeleted rồi ẩn đi; server sẽ bỏ qua row mới bị hủy.
                const deletedInput = row.querySelector("[data-deleted-input]");
                if (deletedInput) {
                    deletedInput.value = "true";
                }
                row.classList.add("d-none");

                if (!existing) {
                    row.dataset.deletedClientSide = "true";
                }

                if (kind && roomIndex !== null) {
                    updateEmptyState(kind, roomIndex);
                }
            });

            form.addEventListener("submit", (event) => {
                if (confirmed) {
                    return;
                }

                event.preventDefault();

                const guestDetailsEditable = form.querySelector('[name="Guest.GuestCode"]:not(:disabled)') !== null;
                if (guestDetailsEditable) {
                    const phone = form.querySelector("[data-guest-phone]");
                    const email = form.querySelector("[data-guest-email]");
                    const phoneError = form.querySelector("[data-guest-phone-error]");
                    const emailError = form.querySelector("[data-guest-email-error]");

                    [phoneError, emailError].forEach((x) => {
                        if (x) {
                            x.textContent = "";
                        }
                    });

                    let customInvalid = false;
                    if (phone && email && !phone.value.trim() && !email.value.trim()) {
                        const message = "Phải nhập ít nhất Số điện thoại hoặc Email.";
                        if (phoneError) phoneError.textContent = message;
                        if (emailError) emailError.textContent = message;
                        customInvalid = true;
                    }

                    if (customInvalid) {
                        const firstCustomInvalid = form.querySelector("[data-guest-phone-error]:not(:empty), [data-guest-email-error]:not(:empty)");
                        firstCustomInvalid?.parentElement?.querySelector("input, select")?.focus();
                        return;
                    }
                }

                if (!form.checkValidity()) {
                    form.classList.add("was-validated");
                    const firstInvalid = form.querySelector(":invalid");
                    firstInvalid?.focus();
                    return;
                }

                const submit = () => {
                    confirmed = true;
                    const button = document.getElementById("bookingEditSubmitButton");
                    if (button && window.HotelUI?.setButtonLoading) {
                        window.HotelUI.setButtonLoading(button, true, "Đang lưu...");
                    }
                    form.submit();
                };

                if (typeof window.HotelUI?.showConfirm === "function") {
                    window.HotelUI.showConfirm({
                        title: "Xác nhận lưu thay đổi",
                        message: `Bạn có chắc chắn muốn lưu thay đổi cho Booking ${@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BookingCode))}?`,
                        note: "Hệ thống sẽ kiểm tra lại trạng thái Booking, sức chứa và tính hợp lệ của dịch vụ/phí phát sinh ngay trước khi lưu.",
                        variant: "primary",
                        confirmText: "Lưu thay đổi",
                        onConfirm: submit
                    });
                } else {
                    submit();
                }
            });
        })();
    </script>
}
