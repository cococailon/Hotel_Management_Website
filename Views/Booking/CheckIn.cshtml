@model Hotel_Management_Website.Models.ViewModels.Booking.BookingCheckInViewModel

@{
    ViewData["Title"] = "Check in khách hàng";
    Layout = User.IsInRole("Reception")
        ? "~/Views/Shared/_ReceptionLayout.cshtml"
        : "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/booking-flow.css" asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Check in khách hàng",
        Description = "Cập nhật thông tin khách đại diện, phân người vào từng BookingRoom và chọn phòng thực tế.",
        Icon = "bi-box-arrow-in-right"
    })

<div class="booking-flow-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-2 mb-4">
        <a asp-controller="Booking" asp-action="Flow" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại quản lý luồng
        </a>
        <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-primary">
            <i class="bi bi-eye me-1"></i>
            Xem chi tiết
        </a>
    </div>

    @{
        var topErrors = ViewData.ModelState
            .Where(x => string.IsNullOrWhiteSpace(x.Key))
            .SelectMany(x => x.Value?.Errors.Select(e => e.ErrorMessage) ?? Enumerable.Empty<string>())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    @if (topErrors.Count > 0)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">
            <div class="fw-semibold mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i>Vui lòng kiểm tra lại thông tin.</div>
            <ul class="mb-0 ps-4">
                @foreach (var error in topErrors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div id="checkInClientTopError" class="alert alert-danger border-0 shadow-sm mb-4 d-none" role="alert">
        <div class="fw-semibold mb-2"><i class="bi bi-exclamation-triangle-fill me-1"></i>Vui lòng kiểm tra lại thông tin.</div>
        <ul class="mb-0 ps-4" id="checkInClientTopErrorList"></ul>
    </div>

    <form asp-controller="Booking" asp-action="CheckIn" method="post" id="bookingCheckInForm" data-ajax="false">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BookingId" />

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="booking-flow-section-icon"><i class="bi bi-person-vcard"></i></div>
                    <div>
                        <h2 class="h6 mb-0 fw-semibold">Thông tin khách hàng (Người đại diện)</h2>
                        <div class="small text-body-secondary">Các trường có dấu * bắt buộc nhập tại thời điểm check in.</div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label for="checkInGuestSearch" class="form-label fw-semibold">
                            Tìm khách hàng có sẵn
                        </label>
                        <input id="checkInGuestSearch"
                               type="search"
                               class="form-control"
                               placeholder="Lọc theo mã hoặc tên..."
                               autocomplete="off" />
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="GuestId" class="form-label fw-semibold">Khách hàng</label>
                        <select asp-for="GuestId"
                                id="checkInGuestId"
                                class="form-select"
                                data-generated-code="@Model.AutoGeneratedGuestCode">
                            <option value="">-- Khách hàng mới --</option>
                            @foreach (var guest in Model.Guests)
                            {
                                <option value="@guest.Id"
                                        data-code="@guest.GuestCode"
                                        data-name="@guest.Name"
                                        data-dob="@(guest.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")"
                                        data-sex="@(guest.Sex?.ToString() ?? "")"
                                        data-address="@guest.Address"
                                        data-phone="@guest.PhoneNumber"
                                        data-email="@guest.Email"
                                        data-identity-number="@guest.IdentityNumber"
                                        data-identity-type="@(guest.IdentityType?.ToString() ?? "")"
                                        data-note="@guest.Note">
                                    @guest.GuestCode · @guest.Name
                                </option>
                            }
                        </select>
                        <div class="form-text">
                            Chọn khách hàng có sẵn để tự điền thông tin. Chọn “Khách hàng mới” để tạo khách mới; có thể chỉnh sửa toàn bộ thông tin trước khi check in.
                        </div>
                        <input type="hidden" asp-for="CreateNewGuest" id="checkInCreateNewGuest" />
                        <span asp-validation-for="GuestId" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="GuestCode" class="form-label fw-semibold">Mã khách hàng</label>
                        <input asp-for="GuestCode"
                               id="checkInGuestCode"
                               class="form-control font-monospace"
                               maxlength="50"
                               autocomplete="off"
                               required />
                        <div class="form-text">
                            Khách mới được tự sinh dạng KH + số lớn nhất + 1; có thể chỉnh sửa nếu cần.
                        </div>
                        <span asp-validation-for="GuestCode" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="GuestName" class="form-label fw-semibold">Tên <span class="text-danger">*</span></label>
                        <input asp-for="GuestName" id="checkInGuestName" class="form-control" maxlength="100" />
                        <span asp-validation-for="GuestName" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="GuestDateOfBirth" class="form-label fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
                        <input asp-for="GuestDateOfBirth" id="checkInGuestDob" type="date" class="form-control" />
                        <span asp-validation-for="GuestDateOfBirth" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="GuestSex" class="form-label fw-semibold">Giới tính <span class="text-danger">*</span></label>
                        <select asp-for="GuestSex" id="checkInGuestSex" class="form-select">
                            <option value="">-- Chọn --</option>
                            <option value="0">Nam</option>
                            <option value="1">Nữ</option>
                            <option value="2">Khác</option>
                        </select>
                        <span asp-validation-for="GuestSex" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="GuestAddress" class="form-label fw-semibold">Địa chỉ <span class="text-danger">*</span></label>
                        <textarea asp-for="GuestAddress" id="checkInGuestAddress" class="form-control" rows="2" maxlength="255"></textarea>
                        <span asp-validation-for="GuestAddress" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="GuestPhoneNumber" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                        <input asp-for="GuestPhoneNumber" id="checkInGuestPhone" class="form-control" maxlength="20" />
                        <span asp-validation-for="GuestPhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="GuestEmail" class="form-label fw-semibold">Email</label>
                        <input asp-for="GuestEmail" id="checkInGuestEmail" type="email" class="form-control" maxlength="255" />
                        <span asp-validation-for="GuestEmail" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="GuestIdentityNumber" class="form-label fw-semibold">Số giấy tờ <span class="text-danger">*</span></label>
                        <input asp-for="GuestIdentityNumber" id="checkInGuestIdentityNumber" class="form-control" maxlength="50" />
                        <span asp-validation-for="GuestIdentityNumber" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="GuestIdentityType" class="form-label fw-semibold">Loại giấy tờ <span class="text-danger">*</span></label>
                        <select asp-for="GuestIdentityType" id="checkInGuestIdentityType" class="form-select">
                            <option value="">-- Chọn --</option>
                            <option value="0">CCCD</option>
                            <option value="1">Giấy phép lái xe</option>
                            <option value="2">Hộ chiếu</option>
                        </select>
                        <span asp-validation-for="GuestIdentityType" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="GuestNote" class="form-label fw-semibold">Ghi chú khách hàng</label>
                        <textarea asp-for="GuestNote" id="checkInGuestNote" class="form-control" rows="2" maxlength="255"></textarea>
                        <span asp-validation-for="GuestNote" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="booking-flow-section-icon"><i class="bi bi-people"></i></div>
                    <div>
                        <h2 class="h6 mb-0 fw-semibold">Phân người và chọn phòng thực tế</h2>
                        <div class="small text-body-secondary">Tổng người phân bổ phải khớp chính xác với TotalAdults/TotalChildren của Booking.</div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label asp-for="TotalAdults" class="form-label fw-semibold">Tổng người lớn <span class="text-danger">*</span></label>
                        <input asp-for="TotalAdults" type="number" min="1" class="form-control" />
                        <span asp-validation-for="TotalAdults" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="TotalChildren" class="form-label fw-semibold">Tổng trẻ em <span class="text-danger">*</span></label>
                        <input asp-for="TotalChildren" type="number" min="0" class="form-control" />
                        <span asp-validation-for="TotalChildren" class="text-danger"></span>
                    </div>
                </div>

                @{
                    string? previousRoomTypeKey = null;
                }

                @for (var i = 0; i < Model.Rooms.Count; i++)
                {
                    var room = Model.Rooms[i];
                    var roomTypeKey = $"{room.RoomTypeCode}|{room.RoomTypeName}";
                    if (!string.Equals(previousRoomTypeKey, roomTypeKey, StringComparison.Ordinal))
                    {
                        previousRoomTypeKey = roomTypeKey;
                        <div class="alert alert-light border shadow-sm mb-3">
                            <div class="fw-semibold booking-breakable">
                                <i class="bi bi-door-open me-1" aria-hidden="true"></i>
                                Nhóm loại phòng: <span class="font-monospace">@room.RoomTypeCode</span> · @room.RoomTypeName
                            </div>
                        </div>
                    }

                    <div class="booking-checkin-room-card border rounded-3 p-3 mb-3">
                        <input type="hidden" asp-for="Rooms[i].BookingRoomId" />
                        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mb-3">
                            <div>
                                <div class="fw-semibold booking-breakable">
                                    <span class="font-monospace">@room.RoomTypeCode</span> · @room.RoomTypeName
                                </div>
                                <div class="small text-body-secondary">BookingRoom @i.ToString("00")</div>
                            </div>
                            <span class="badge text-bg-light border text-body align-self-start">Phải chọn 1 phòng thực tế</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-lg-5">
                                <label asp-for="Rooms[i].RoomId" class="form-label fw-semibold">Phòng <span class="text-danger">*</span></label>
                                <select asp-for="Rooms[i].RoomId" class="form-select">
                                    <option value="">-- Chọn phòng --</option>
                                    @foreach (var option in room.AvailableRooms)
                                    {
                                        <option value="@option.Id">@option.RoomCode · @option.RoomName · @option.RoomTypeName</option>
                                    }
                                </select>
                                <span asp-validation-for="Rooms[i].RoomId" class="text-danger"></span>
                            </div>
                            <div class="col-6 col-lg-2">
                                <label asp-for="Rooms[i].Adults" class="form-label fw-semibold">Người lớn</label>
                                <input asp-for="Rooms[i].Adults" type="number" min="0" class="form-control room-adults-input" />
                                <span asp-validation-for="Rooms[i].Adults" class="text-danger"></span>
                            </div>
                            <div class="col-6 col-lg-2">
                                <label asp-for="Rooms[i].Children" class="form-label fw-semibold">Trẻ em</label>
                                <input asp-for="Rooms[i].Children" type="number" min="0" class="form-control room-children-input" />
                                <span asp-validation-for="Rooms[i].Children" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-lg-3">
                                <label asp-for="Rooms[i].Note" class="form-label fw-semibold">Ghi chú BookingRoom</label>
                                <textarea asp-for="Rooms[i].Note" class="form-control" rows="2" maxlength="255"></textarea>
                                <span asp-validation-for="Rooms[i].Note" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <label asp-for="BookingNote" class="form-label fw-semibold">Ghi chú Booking</label>
                <textarea asp-for="BookingNote" class="form-control" rows="3" maxlength="255"></textarea>
                <span asp-validation-for="BookingNote" class="text-danger"></span>
            </div>
        </section>

        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mb-4">
            <a asp-controller="Booking" asp-action="Flow" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary" id="bookingCheckInSubmit">
                <span class="ui-button-content"><i class="bi bi-check2-circle me-1"></i> Xác nhận check in</span>
                <span class="ui-button-loading d-none"><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Đang xử lý...</span>
            </button>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            "use strict";
            const form = document.getElementById("bookingCheckInForm");
            if (!form) return;
            const serverErrorBox = document.querySelector(".booking-flow-page > .alert.alert-danger:not(#checkInClientTopError)");
            if (serverErrorBox) {
                requestAnimationFrame(() => serverErrorBox.scrollIntoView({ behavior: "smooth", block: "start" }));
            }
            let confirmed = false;

            const guestSelect = document.getElementById("checkInGuestId");
            const guestSearch = document.getElementById("checkInGuestSearch");
            const createNewGuestField = document.getElementById("checkInCreateNewGuest");
            const guestCode = document.getElementById("checkInGuestCode");
            const guestName = document.getElementById("checkInGuestName");
            const guestDob = document.getElementById("checkInGuestDob");
            const guestSex = document.getElementById("checkInGuestSex");
            const guestAddress = document.getElementById("checkInGuestAddress");
            const guestPhone = document.getElementById("checkInGuestPhone");
            const guestEmail = document.getElementById("checkInGuestEmail");
            const guestIdentityNumber = document.getElementById("checkInGuestIdentityNumber");
            const guestIdentityType = document.getElementById("checkInGuestIdentityType");
            const guestNote = document.getElementById("checkInGuestNote");

            const setValue = (element, value) => {
                if (element) {
                    element.value = value ?? "";
                }
            };

            const clearGuestFieldsForNew = () => {
                const generatedCode = guestSelect?.dataset.generatedCode || "";
                setValue(guestCode, generatedCode);
                setValue(guestName, "");
                setValue(guestDob, "");
                setValue(guestSex, "");
                setValue(guestAddress, "");
                setValue(guestPhone, "");
                setValue(guestEmail, "");
                setValue(guestIdentityNumber, "");
                setValue(guestIdentityType, "");
                setValue(guestNote, "");
                if (createNewGuestField) {
                    createNewGuestField.value = "true";
                }
            };

            const applyGuest = option => {
                if (!option || !option.value) {
                    clearGuestFieldsForNew();
                    return;
                }

                if (createNewGuestField) {
                    createNewGuestField.value = "false";
                }

                setValue(guestCode, option.dataset.code);
                setValue(guestName, option.dataset.name);
                setValue(guestDob, option.dataset.dob);
                setValue(guestSex, option.dataset.sex);
                setValue(guestAddress, option.dataset.address);
                setValue(guestPhone, option.dataset.phone);
                setValue(guestEmail, option.dataset.email);
                setValue(guestIdentityNumber, option.dataset.identityNumber);
                setValue(guestIdentityType, option.dataset.identityType);
                setValue(guestNote, option.dataset.note);
            };

            guestSelect?.addEventListener("change", () => {
                applyGuest(guestSelect.selectedOptions[0]);
            });

            if (guestSearch && guestSelect) {
                guestSearch.addEventListener("input", () => {
                    const query = guestSearch.value.trim().toLowerCase();
                    Array.from(guestSelect.options).forEach(option => {
                        if (!option.value) {
                            option.hidden = false;
                            return;
                        }

                        option.hidden =
                            query.length > 0 &&
                            !option.textContent.toLowerCase().includes(query);
                    });
                });
            }

            const initialGuestOption = guestSelect?.selectedOptions[0];
            if (initialGuestOption?.value) {
                applyGuest(initialGuestOption);
            } else {
                clearGuestFieldsForNew();
            }

            form.addEventListener("submit", event => {
                if (confirmed) return;
                event.preventDefault();

                // Validate thông tin khách hàng trước; chỉ khi phần này hợp lệ mới kiểm tra phân người/chọn phòng.
                const guestSection = form.querySelector(".card:first-of-type");
                if (guestSection) {
                    const guestFields = [...guestSection.querySelectorAll("input, select, textarea")];
                    const invalidGuestField = guestFields.find(field => !field.checkValidity());
                    if (invalidGuestField) {
                        invalidGuestField.reportValidity();
                        invalidGuestField.focus();
                        return;
                    }
                }

                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                const adults = Number(form.querySelector('[name="TotalAdults"]')?.value || 0);
                const children = Number(form.querySelector('[name="TotalChildren"]')?.value || 0);
                const roomAdults = [...form.querySelectorAll('.room-adults-input')].reduce((sum, el) => sum + Number(el.value || 0), 0);
                const roomChildren = [...form.querySelectorAll('.room-children-input')].reduce((sum, el) => sum + Number(el.value || 0), 0);
                if (adults !== roomAdults || children !== roomChildren) {
                    const errorBox = document.getElementById("checkInClientTopError");
                    const errorList = document.getElementById("checkInClientTopErrorList");
                    if (errorBox && errorList) {
                        errorList.replaceChildren();
                        const li = document.createElement("li");
                        li.textContent = `Phân bổ người chưa khớp: tổng người lớn đã phân bổ ${roomAdults}/${adults}, tổng trẻ em đã phân bổ ${roomChildren}/${children}.`;
                        errorList.appendChild(li);
                        errorBox.classList.remove("d-none");
                    }
                    errorBox?.scrollIntoView({ behavior: "smooth", block: "start" });
                    return;
                }

                const submit = () => {
                    confirmed = true;
                    const button = document.getElementById("bookingCheckInSubmit");
                    if (button && window.HotelUI?.setButtonLoading) window.HotelUI.setButtonLoading(button, true, "Đang xử lý...");
                    form.submit();
                };
                const showConfirm = window.HotelUI?.showConfirm;
                if (typeof showConfirm === "function") {
                    showConfirm({
                        title: "Xác nhận check in",
                        message: "Bạn có chắc chắn muốn check in Booking này?",
                        note: "Hệ thống sẽ cập nhật Guest, gán phòng, ghi nhận phân bổ người và chuyển Booking sang Đang ở.",
                        variant: "primary",
                        confirmText: "Xác nhận check in",
                        onConfirm: submit
                    });
                } else submit();
            });
        })();
    </script>
}
