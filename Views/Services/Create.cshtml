@model Hotel_Management_Website.Models.ViewModels.Service.ServiceCreateViewModel

@{
    ViewData["Title"] = "Tạo dịch vụ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/service-form.css" asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Tạo dịch vụ",
        Description = "Tạo dịch vụ mới để có thể gán cho các loại phòng.",
        Icon = "bi-cone-striped"
    })

<div class="service-form-page">
    <form id="serviceCreateForm"
          asp-controller="Services"
          asp-action="Create"
          method="post"
          novalidate
          data-native-validation="true"
          data-ajax="false"
          data-service-form="create">
        @Html.AntiForgeryToken()

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="service-form-section-icon" aria-hidden="true"><i class="bi bi-cone-striped"></i></div>
                    <div>
                        <h2 class="h5 mb-1 fw-semibold">Thông tin dịch vụ</h2>
                        <p class="text-body-secondary small mb-0">Thông tin chính của dịch vụ.</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12 col-lg-6">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <label asp-for="ServiceCode" class="form-label required mb-0">Mã dịch vụ</label>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="generateServiceCodeButton">
                                <i class="bi bi-magic me-1" aria-hidden="true"></i>
                                Tự sinh mã
                            </button>
                        </div>
                        <input asp-for="ServiceCode" class="form-control" maxlength="50" autocomplete="off" spellcheck="false" />
                        <span asp-validation-for="ServiceCode" class="text-danger"></span>
                        <div class="form-text">Bắt buộc nhập. Chỉ được chứa chữ cái và chữ số, không có dấu cách hoặc ký tự đặc biệt, và không được trùng.</div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="ServiceName" class="form-label required">Tên dịch vụ</label>
                        <input asp-for="ServiceName" class="form-control" maxlength="100" autocomplete="off" placeholder="Ví dụ: Giặt ủi" />
                        <span asp-validation-for="ServiceName" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="UnitPrice" class="form-label">Đơn giá</label>
                        <div class="input-group">
                            <input asp-for="UnitPrice" class="form-control" type="number" min="0" step="0.01" />
                            <span class="input-group-text">₫</span>
                        </div>
                        <span asp-validation-for="UnitPrice" class="text-danger"></span>
                        <div class="form-text">0 hoặc để trống = miễn phí.</div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="PriceUnitType" class="form-label">Đơn vị</label>
                        <input asp-for="PriceUnitType" class="form-control" maxlength="50" placeholder="/người/lần/kg" autocomplete="off" />
                        <span asp-validation-for="PriceUnitType" class="text-danger"></span>
                        <div class="form-text">Nếu có phí, nhập theo dạng /x/x/x...</div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="IsActive" class="form-label">Trạng thái</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Dừng hoạt động</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="service-form-section-icon" aria-hidden="true"><i class="bi bi-card-text"></i></div>
                    <div>
                        <h2 class="h5 mb-1 fw-semibold">Mô tả và ghi chú</h2>
                        <p class="text-body-secondary small mb-0">Thông tin bổ sung cho dịch vụ.</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4" maxlength="255" placeholder="Mô tả ngắn về dịch vụ..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Note" class="form-label">Ghi chú</label>
                    <textarea asp-for="Note" class="form-control" rows="4" maxlength="255" placeholder="Ghi chú nội bộ nếu có..."></textarea>
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
            </div>
        </section>

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 mb-4">
            <a asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary service-form-cancel-btn">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                Quay lại danh sách
            </a>
            <button type="submit" class="btn btn-primary" id="serviceCreateSubmitButton">
                <span class="ui-button-content">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                    Tạo dịch vụ
                </span>
                <span class="ui-button-loading d-none">
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    Đang tạo...
                </span>
            </button>
        </div>
    </form>
</div>

@section Scripts
{
    <script src="~/js/native-validation.js" asp-append-version="true"></script>
    <script src="~/js/service-form.js" asp-append-version="true"></script>
}
