@model Hotel_Management_Website.Models.ViewModels.Service.ServiceEditViewModel

@{
    ViewData["Title"] = "Sửa dịch vụ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/service-form.css" asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Views/Shared/UI/_PageHeader.cshtml",
    new Hotel_Management_Website.Models.ViewModels.UI.PageHeaderViewModel
    {
        Title = "Sửa dịch vụ",
        Description = $"Cập nhật thông tin dịch vụ {Model.ServiceCode}.",
        Icon = "bi-pencil-square"
    })

<div class="service-form-page">
    <form id="serviceEditForm"
          asp-controller="Services"
          asp-action="Edit"
          method="post"
          novalidate
          data-native-validation="true"
          data-service-form="edit"
          data-ajax="false"
          data-has-active-bookings="@Model.HasActiveBookings.ToString().ToLowerInvariant()">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />

        @if (Model.HasActiveBookings)
        {
            <div class="alert alert-warning d-flex gap-2 align-items-start mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
                <div>
                    <div class="fw-semibold">Dịch vụ đang được sử dụng bởi loại phòng nằm trong lịch đặt phòng có trạng thái là chờ xác nhận, chờ check in hoặc đang ở.</div>
                    <div>Chỉ được sửa <strong>Mô tả</strong> và <strong>Ghi chú</strong>. Mã, tên, đơn giá và đơn vị dịch vụ được giữ nguyên.</div>
                </div>
            </div>
        }

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="service-form-section-icon" aria-hidden="true"><i class="bi bi-cone-striped"></i></div>
                    <div>
                        <h2 class="h5 mb-1 fw-semibold">Thông tin dịch vụ</h2>
                        <p class="text-body-secondary small mb-0">Thông tin chính của dịch vụ.</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12 col-lg-6">
                        <label asp-for="ServiceCode" class="form-label required">Mã dịch vụ</label>
                        <input asp-for="ServiceCode"
                               class="form-control"
                               style="@(Model.HasActiveBookings ? "background-color: #343a40;" : null)"
                               maxlength="50"
                               autocomplete="off"
                               spellcheck="false"
                               readonly="@(Model.HasActiveBookings ? "readonly" : null)" />
                        <div class="form-text">Bắt buộc nhập. Chỉ được chứa chữ cái và chữ số, không có dấu cách hoặc ký tự đặc biệt, và không được trùng.</div>
                        <span asp-validation-for="ServiceCode" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="ServiceName" class="form-label required">Tên dịch vụ</label>
                        <input asp-for="ServiceName"
                               class="form-control"
                               style="@(Model.HasActiveBookings ? "background-color: #343a40;" : null)"
                               maxlength="100"
                               autocomplete="off"
                               readonly="@(Model.HasActiveBookings ? "readonly" : null)" />
                        <span asp-validation-for="ServiceName" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="UnitPrice" class="form-label">Đơn giá</label>
                        <div class="input-group">
                            <input asp-for="UnitPrice"
                                   class="form-control"
                                   style="@(Model.HasActiveBookings ? "background-color: #343a40;" : null)"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   readonly="@(Model.HasActiveBookings ? "readonly" : null)" />
                            <span class="input-group-text">₫</span>
                        </div>
                        <div class="form-text">0 hoặc để trống = miễn phí.</div>
                        <span asp-validation-for="UnitPrice" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="PriceUnitType" class="form-label">Đơn vị</label>
                        <input asp-for="PriceUnitType"
                               class="form-control"
                               style="@(Model.HasActiveBookings ? "background-color: #343a40;" : null)"
                               maxlength="50"
                               placeholder="/người/lần/kg"
                               autocomplete="off"
                               readonly="@(Model.HasActiveBookings ? "readonly" : null)" />
                        <div class="form-text">Nếu có phí, nhập theo dạng /x/x/x...</div>
                        <span asp-validation-for="PriceUnitType" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-body border-bottom">
                <div class="d-flex align-items-center gap-3">
                    <div class="service-form-section-icon" aria-hidden="true"><i class="bi bi-card-text"></i></div>
                    <div>
                        <h2 class="h5 mb-1 fw-semibold">Mô tả và ghi chú</h2>
                        <p class="text-body-secondary small mb-0">Thông tin bổ sung về dịch vụ.</p>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="4" maxlength="255"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="Note" class="form-label">Ghi chú</label>
                    <textarea asp-for="Note" class="form-control" rows="4" maxlength="255"></textarea>
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
            </div>
        </section>

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 mb-4">
            <a href="@(Model.ReturnUrl ?? Url.Action("Index", "Services"))" class="btn btn-outline-secondary service-form-cancel-btn">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                Quay lại danh sách
            </a>
            <button type="submit" class="btn btn-primary" id="serviceEditSubmitButton">
                <span class="ui-button-content">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                    Lưu thay đổi
                </span>
                <span class="ui-button-loading d-none">
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    Đang lưu...
                </span>
            </button>
        </div>
    </form>
</div>

@section Scripts
{
    <script src="~/js/native-validation.js" asp-append-version="true"></script>
    <script src="~/js/service-form.js" asp-append-version="true"></script>
}
